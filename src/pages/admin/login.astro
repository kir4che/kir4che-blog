---
export const prerender = false;

import { UserRound, Lock } from '@lucide/astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { isAuthenticated, setAdminSessionCookie, verifyAdminCredentials } from '@/lib/admin';

let errorMessage = '';

if (import.meta.env.DEV) {
  await setAdminSessionCookie(Astro.cookies);
  return Astro.redirect('/admin');
}

if (await isAuthenticated(Astro.cookies)) return Astro.redirect('/admin');

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const username = (data.get('username') as string) || '';
    const password = (data.get('password') as string) || '';

    if (verifyAdminCredentials(username, password)) {
      await setAdminSessionCookie(Astro.cookies);
      return Astro.redirect('/admin');
    } else errorMessage = '帳號或密碼錯誤，請重新輸入！';
  } catch (err) {
    errorMessage = '登入時發生未知的錯誤，請稍後再試！';
  }
}
---

<AdminLayout title="管理員登入">
  <div id="login-root" data-error-message={errorMessage} class="flex-center min-h-screen">
    <div class="card bg-surface-secondary w-full max-w-sm rounded-md shadow-md">
      <div class="card-body">
        <h2 class="card-title mb-4 justify-center text-2xl">後台登入</h2>
        <form method="POST" class="space-y-4">
          <label class="input rounded border border-gray-200">
            <UserRound size={20} aria-hidden="true" />
            <input type="text" name="username" placeholder="請輸入管理員帳號" required />
          </label>
          <label class="input rounded border border-gray-200">
            <Lock size={20} aria-hidden="true" />
            <input type="password" name="password" placeholder="請輸入密碼" required />
          </label>
          <button
            type="submit"
            class="btn btn-primary text-surface-secondary mt-6 w-full rounded-full">登入</button
          >
        </form>
      </div>
    </div>
  </div>
  <script is:inline>
    const errorMessageClient = document.getElementById('login-root')?.dataset.errorMessage ?? '';
    if (errorMessageClient) {
      window.dispatchEvent(
        new CustomEvent('toast', {
          detail: { message: errorMessageClient, variant: 'error' },
        })
      );
    }
  </script>
</AdminLayout>
