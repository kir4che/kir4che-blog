---
export const prerender = false;

import {
  LogOut,
  Plus,
  Search,
  Pencil,
  Trash2,
  X,
  ChevronDown,
  ChevronRight,
  Download,
} from '@lucide/astro';

import { DEFAULT_LANGUAGE } from '@/config';
import type { Language } from '@/types';
import { deleteAdminPost, getAdminPosts } from '@/lib/admin';
import { isAuthenticated, clearAdminSessionCookie } from '@/lib/auth';
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminPostListSection from '@/components/features/admin/AdminPostListSection.astro';
import TaxonomyManager from '@/components/features/admin/TaxonomyManager';
import { categoryMap, tagMap } from '@/config/taxonomy';

if (!(await isAuthenticated(Astro.cookies))) return Astro.redirect('/admin/login');

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');

  if (action === 'logout') {
    clearAdminSessionCookie(Astro.cookies);
    return Astro.redirect('/admin/login');
  }
  if (action === 'delete') {
    const id = data.get('id') as string;
    if (id) await deleteAdminPost(id);
    return Astro.redirect('/admin');
  }
}

const posts = await getAdminPosts();
const draftCount = posts.filter((p) => p.meta.draft).length;
const publishedCount = posts.length - draftCount;

const postsByLang = new Map<Language, typeof posts>();
for (const post of posts) {
  const items = postsByLang.get(post.lang) ?? [];
  postsByLang.set(post.lang, [...items, post]);
}

const sortedLangEntries = Array.from(postsByLang).sort(([a], [b]) => a.localeCompare(b));

const initialCategories = categoryMap;
const initialTags = tagMap;
---

<AdminLayout title="文章管理">
  <div class="min-h-screen p-6 md:p-8" data-default-lang={DEFAULT_LANGUAGE}>
    <div class="mx-auto max-w-6xl space-y-4">
      <div class="flex-between gap-4">
        <div class="flex items-center gap-3">
          <h1>文章管理</h1>
          <a
            href="/admin/editor"
            class="btn border-primary hover:bg-primary flex-center text-primary bg-surface-secondary hover:text-surface-secondary size-6 rounded-full p-0"
            aria-label="新增文章"
          >
            <Plus size={16} aria-hidden="true" />
          </a>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm font-medium hover:opacity-80">回到首頁</a>
          <form method="POST" class="m-0">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="flex-center gap-1 text-sm font-medium hover:opacity-80">
              <LogOut size={16} aria-hidden="true" />
              登出
            </button>
          </form>
        </div>
      </div>
      <div class="bg-surface-secondary space-y-3 rounded p-5 shadow">
        <div class="flex-between flex-wrap gap-3">
          <label class="input w-fit rounded-full border border-gray-300 md:min-w-64">
            <Search size={16} />
            <input
              type="search"
              autocomplete="off"
              data-search-input
              placeholder="搜尋文章標題或 slug"
            />
          </label>
          <div class="ml-auto flex flex-wrap gap-3 text-sm">
            <select data-status-select class="border px-1 py-0.5">
              <option value="all">全部狀態 ({posts.length})</option>
              <option value="published">已發布 ({publishedCount})</option>
              <option value="draft">草稿 ({draftCount})</option>
            </select>
            <select data-lang-select class="border px-1 py-0.5">
              {
                sortedLangEntries.map(([lang, langPosts]) => (
                  <option value={lang} selected={lang === DEFAULT_LANGUAGE}>
                    {lang} ({langPosts.length})
                  </option>
                ))
              }
            </select>
          </div>
        </div>
        {
          sortedLangEntries.map(([lang, langPosts]) => (
            <AdminPostListSection lang={lang} posts={langPosts} />
          ))
        }
        {posts.length === 0 && <p class="py-10 text-center text-gray-500">尚無文章</p>}
      </div>
      <div class="bg-surface-secondary rounded p-5 shadow">
        <TaxonomyManager
          client:load
          initialCategories={initialCategories}
          initialTags={initialTags}
        />
      </div>
    </div>
  </div>
  <script>
    const defaultRoot = document.querySelector('[data-default-lang]') as HTMLElement | null;
    const defaultLang = defaultRoot?.dataset.defaultLang || '';

    const searchInput = document.querySelector('[data-search-input]') as HTMLInputElement | null;
    const statusSelect = document.querySelector('[data-status-select]') as HTMLSelectElement | null;
    const langSelect = document.querySelector('[data-lang-select]') as HTMLSelectElement | null;

    const sections = document.querySelectorAll('[data-lang-section]') as NodeListOf<HTMLElement>;

    if (langSelect && defaultLang) langSelect.value = defaultLang;

    const applyFilters = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const status = statusSelect?.value || 'all';
      const lang = langSelect?.value || defaultLang;

      // 先篩選「所選語系」的文章
      sections.forEach((sec) => {
        if (sec.dataset.langSection !== lang) {
          sec.classList.add('hidden');
          return;
        }

        // 再針對「所選語系」的文章進行篩選
        let hasVisibleItems = false;
        const items = sec.querySelectorAll(
          '[data-post-row], [data-post-card]'
        ) as NodeListOf<HTMLElement>;

        items.forEach((el) => {
          const matchQuery = !query || (el.dataset.search || '').includes(query);
          const matchStatus = status === 'all' || el.dataset.status === status;
          const isVisible = matchQuery && matchStatus;

          el.classList.toggle('hidden', !isVisible);
          if (isVisible) hasVisibleItems = true;
        });

        sec.classList.toggle('hidden', !hasVisibleItems);
      });
    };

    const inputs = [searchInput, statusSelect, langSelect].filter(Boolean) as HTMLElement[];
    inputs.forEach((el) => {
      el.addEventListener('input', applyFilters);
    });

    applyFilters();
  </script>
</AdminLayout>

<template data-icon-pencil><Pencil size={14} aria-hidden="true" /></template>
<template data-icon-trash><Trash2 size={14} aria-hidden="true" /></template>
<template data-icon-x><X size={14} aria-hidden="true" /></template>
<template data-icon-plus><Plus size={14} aria-hidden="true" /></template>
<template data-icon-chevron-down><ChevronDown size={14} aria-hidden="true" /></template>
<template data-icon-chevron-right><ChevronRight size={14} aria-hidden="true" /></template>
<template data-icon-search><Search size={14} aria-hidden="true" /></template>
<template data-icon-download><Download size={14} aria-hidden="true" /></template>
