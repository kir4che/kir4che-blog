---
export const prerender = false;

import PostEditor from '@/components/features/admin/Editor';
import { categoryMap, tagMap } from '@/config/taxonomy';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getAdminPost } from '@/lib/admin';
import { isAuthenticated } from '@/lib/auth';
import { toLocalISO } from '@/utils/date';

if (!(await isAuthenticated(Astro.cookies))) return Astro.redirect('/admin/login');

const id = Astro.url.searchParams.get('id');
const post = id ? await getAdminPost(id) : null;

if (id && !post) return Astro.redirect('/admin');

const isEditing = !!post;
const defaultDate = toLocalISO(isEditing ? post.meta.date : undefined);
const previewUrl = post ? `/admin/preview?id=${post.id}` : '';

const allCategories = Object.values(categoryMap).flatMap((cat) => {
  const items = [{ slug: cat.slug, label: cat.name.tw ?? cat.slug }];
  if (cat.subcategories)
    items.push(
      ...Object.values(cat.subcategories).map((sub) => ({
        slug: sub.slug,
        label: sub.name.tw ?? sub.slug,
      }))
    );
  return items;
});

const allTags = Object.values(tagMap).map((tag) => ({
  slug: tag.slug,
  label: tag.name.tw ?? tag.slug,
}));

const postData = post
  ? {
      id: post.id,
      slug: post.slug,
      lang: post.lang,
      title: post.meta.title,
      content: post.content,
      description: post.meta.description || '',
      coverImage: post.meta.coverImage || '',
      categories: post.meta.categories || [],
      tags: post.meta.tags || [],
      featured: post.meta.featured || false,
      draft: post.meta.draft !== false,
      showUpdatedAt: post.meta.showUpdatedAt || false,
      protected: post.meta.protected || false,
      updatedAt: post.meta.updatedAt || '',
      date: post.meta.date?.toString() || '',
    }
  : null;
---

<AdminLayout title={isEditing ? '編輯文章' : '新增文章'}>
  <PostEditor
    client:load
    post={postData}
    isEditing={isEditing}
    defaultDate={defaultDate}
    previewUrl={previewUrl}
    allCategories={allCategories}
    allTags={allTags}
  />
</AdminLayout>
