---
export const prerender = false;

import PostLayout from '@/layouts/PostLayout.astro';
import { getAdminPost } from '@/lib/admin';
import { isAuthenticated } from '@/lib/auth';
import { countWordsFromMarkdown, getPostExtraComponents } from '@/lib/posts';
import type { Post } from '@/types/post';
import { getEntry, render } from 'astro:content';

if (!isAuthenticated(Astro.cookies)) return Astro.redirect('/admin/login');

const id = Astro.url.searchParams.get('id');
if (!id) return new Response('Not found', { status: 404 });

const adminPost = await getAdminPost(id);
if (!adminPost) return new Response('Not found', { status: 404 });

// 從 Astro 的 Content Collections 抓取對應的檔案內容
const entry = await getEntry('blog', id as any);
if (!entry) return new Response('找不到該文章！請嘗試重啟伺服器或等待索引建立。', { status: 404 });

// 將 Markdown 轉成 HTML 元件與標題資訊
const rendered = await render(entry);

const post: Post = {
  ...adminPost.meta,
  content: entry.body || '',
  headings: rendered.headings,
  rendered,
  wordCount: countWordsFromMarkdown(entry.body || ''),
};

const extraComponents = await getPostExtraComponents(post.slug);
---

<PostLayout
  lang={adminPost.lang}
  post={post}
  otherLangs={[]}
  isProtected={false}
  content={rendered.Content}
  headings={rendered.headings ?? []}
  extraComponents={extraComponents}
/>

<script>
  import morphdom from 'morphdom';

  // 監聽編輯器傳來的預覽更新訊息
  window.addEventListener('message', (e: MessageEvent) => {
    // 只接收來自同一網域的訊息，避免惡意攻擊。
    if (e.origin !== location.origin) return;
    const data = e.data as { type?: string; html?: string } | null;
    if (!data || data.type !== 'preview-update' || typeof data.html !== 'string') return;

    const postBody = document.getElementById('post-body');
    if (!postBody) return;

    // 將收到的新 HTML 字串轉換成瀏覽器可理解的 DOM 節點
    const doc = new DOMParser().parseFromString(data.html, 'text/html');
    const next = doc.body.firstElementChild as HTMLElement | null;
    if (!next) return;
    // 將新節點 id 設為相同，以便 morphdom 進行平滑替換。
    next.id = 'post-body';
    // 比較舊/新內容的差異，只更新變動的部分。
    morphdom(postBody, next);

    // 手動恢復圖片可見度
    postBody.querySelectorAll<HTMLImageElement>('img.opacity-0').forEach((img) => {
      if (img.complete) {
        img.classList.remove('opacity-0');
      } else {
        img.addEventListener('load', () => img.classList.remove('opacity-0'), { once: true });
        img.addEventListener('error', () => img.classList.remove('opacity-0'), { once: true });
      }
    });
  });
</script>
