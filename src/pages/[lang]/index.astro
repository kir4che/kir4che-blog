---
export const prerender = true;

import Announcement from '@/components/ui/Announcement.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createTranslator, getLangStaticPaths, resolveLanguage } from '@/lib/i18n';
import { paginate } from '@/lib/pagination';
import { withLocalePrefix } from '@/lib/paths';
import { getPostsMeta } from '@/lib/posts';
import PostPreviewCard from '@/components/features/post/preview/PostPreviewCard.astro';
import Pagination from '@/components/ui/Pagination.astro';

export const getStaticPaths = getLangStaticPaths;

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'HomePage');

const link = (href: string): string => {
  if (href === '/') return withLocalePrefix('/', lang);
  const pageNum = parseInt(href.replace(/^\//, ''), 10);
  if (!isNaN(pageNum) && pageNum > 1) return withLocalePrefix(`/page/${pageNum}`, lang);
  return withLocalePrefix(href, lang);
};

const visiblePosts = await getPostsMeta(lang, { includeProtected: false });
const { items: currPosts, currPage, totalPages } = paginate(visiblePosts, 1);

const featuredPosts = currPosts.slice(0, 5);
const regularPosts = currPosts.slice(5);

const featuredLeft = featuredPosts.slice(0, 2);
const featuredRight = featuredPosts.slice(2);
// 提前載入第一篇有 coverImage 的精選文章
const lcpPost = featuredPosts.find((post) => Boolean(post.coverImage));
---

<SiteLayout title={t('title')} description={t('description')}>
  {
    lcpPost?.coverImage && (
      <link slot="head" rel="preload" href={lcpPost.coverImage} as="image" fetchpriority="high" />
    )
  }
  <div class="flex min-h-full flex-1 flex-col gap-6">
    {t('announcement') && <Announcement text={t('announcement')} />}
    {
      currPosts.length > 0 && (
        <section id="posts" class="flex flex-1 flex-col gap-3 md:gap-5">
          <div class="flex flex-col gap-3 md:gap-5">
            {featuredPosts.length > 0 && (
              <>
                <div class="grid grid-cols-1 gap-3 md:hidden md:gap-5">
                  {featuredPosts.map((post, i) => (
                    <PostPreviewCard post={post} lang={lang} priority={i === 0} />
                  ))}
                </div>
                <div class="hidden gap-x-3 md:grid md:grid-cols-[48%_1fr] xl:grid-cols-[5fr_4fr]">
                  <div class="grid gap-y-5">
                    {featuredLeft.map((post, i) => (
                      <PostPreviewCard post={post} lang={lang} priority={i === 0} />
                    ))}
                  </div>
                  {featuredRight.length > 0 && (
                    <div class="grid gap-y-5">
                      {featuredRight.map((post) => (
                        <PostPreviewCard post={post} lang={lang} />
                      ))}
                    </div>
                  )}
                </div>
              </>
            )}
            {regularPosts.length > 0 && (
              <div class="grid gap-3 md:gap-5">
                {regularPosts.map((post) => (
                  <PostPreviewCard post={post} lang={lang} hideImage />
                ))}
              </div>
            )}
          </div>
          <Pagination
            t={t}
            link={link}
            basePath=""
            page1Path="/"
            currPage={currPage}
            totalPages={totalPages}
          />
        </section>
      )
    }
  </div>
</SiteLayout>
