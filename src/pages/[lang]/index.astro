---
export const prerender = false;

import Announcement from '@/components/ui/Announcement.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createTranslator, resolveLanguage } from '@/lib/i18n';
import { paginate } from '@/lib/pagination';
import { withLocalePrefix } from '@/lib/paths';
import { getSidebarData } from '@/lib/sidebar';
// import Advertisement from '@/components/ui/Advertisement.astro';
import PostPreviewCard from '@/components/features/post/preview/PostPreviewCard.astro';
import PostPreviewList from '@/components/features/post/preview/PostPreviewList.astro';
import Pagination from '@/components/ui/Pagination.astro';

// const AD_INSERT_INDEX = 3;

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'HomePage');

const link = (href: string) => withLocalePrefix(href, lang);

const { posts = [] } = await getSidebarData(lang);
const visiblePosts = posts.filter((post) => !post.protected);

const pageParam = Number(Astro.url.searchParams.get('page'));
const page = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;

const { items: currPosts, currPage, totalPages } = paginate(visiblePosts, page);

const isFirstPage = currPage === 1;
const leftPosts = isFirstPage ? currPosts.slice(0, 2) : [];
const highlightPosts = isFirstPage ? currPosts.slice(2, 5) : [];
const mobileFeaturedPosts = isFirstPage ? currPosts.slice(0, 5) : [];
const listPosts = isFirstPage ? currPosts.slice(5) : currPosts;
---

<SiteLayout title={t('title')} description={t('description')}>
  <div class="flex min-h-full flex-1 flex-col gap-6">
    <Announcement text={t('announcement')} />
    {
      currPosts.length > 0 && (
        <section id="posts" class="flex flex-1 flex-col gap-6">
          <div class="flex flex-col gap-6">
            {isFirstPage ? (
              <>
                <div class="grid grid-cols-1 gap-2 md:hidden">
                  {mobileFeaturedPosts.map((post) => (
                    <PostPreviewCard post={post} lang={lang} />
                  ))}
                </div>
                <div class="hidden md:grid md:grid-cols-[5fr_4fr] md:gap-4">
                  {leftPosts.length > 0 && (
                    <div class="grid gap-4">
                      {leftPosts.map((post) => (
                        <PostPreviewCard post={post} lang={lang} />
                      ))}
                    </div>
                  )}
                  {highlightPosts.length > 0 && (
                    <div class="grid gap-4">
                      {highlightPosts.map((post) => (
                        <PostPreviewCard post={post} lang={lang} />
                      ))}
                    </div>
                  )}
                </div>
                {listPosts.length > 0 && (
                  <div class="grid gap-2 md:gap-4">
                    {listPosts.map((post) => (
                      <>
                        <PostPreviewList post={post} lang={lang} />
                        {/* {index === AD_INSERT_INDEX && <Advertisement />} */}
                      </>
                    ))}
                  </div>
                )}
              </>
            ) : (
              <div class="grid gap-2 md:gap-4">
                {listPosts.map((post) => (
                  <PostPreviewList post={post} lang={lang} />
                ))}
              </div>
            )}
          </div>
          <Pagination t={t} link={link} basePath="/" currPage={currPage} totalPages={totalPages} />
        </section>
      )
    }
  </div>
</SiteLayout>
