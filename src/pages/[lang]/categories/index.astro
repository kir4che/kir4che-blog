---
import type { PostMeta } from '@/types';
import { resolveLanguage, createTranslator } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import { getPostsInfo } from '@/lib/posts';
import { getAllCategoryByPosts, getCategoryStyle } from '@/lib/categories';
import SiteLayout from '@/layouts/SiteLayout.astro';

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'CategoriesPage');

let posts: PostMeta[] = [];

try {
  posts = await getPostsInfo(lang);
} catch (err) {
  console.error('[CategoriesPage] Failed to load posts info.', err);
}

const categories = getAllCategoryByPosts(posts);
const categoryBasePath = withLocalePrefix('/categories', lang);
---

<SiteLayout title={t('title')}>
  <h1 class="mb-4">{t('title')}</h1>
  {
    categories.length === 0 ? (
      <p class="text-foreground-primary/80 text-sm">{t('noCategories')}</p>
    ) : (
      <div class="xs:grid-cols-2 grid grid-cols-1 gap-4 xl:grid-cols-4">
        {categories.map(({ name, slug, color, postCount = 0, subcategories }) => {
          const categoryName = name[lang] ?? name.en ?? Object.values(name)[0];

          return (
            <div
              class="bg-surface-secondary flex flex-col rounded-lg border-2 border-(--category-color) p-3 transition-colors duration-300 dark:border-(--category-color-dark)"
              style={getCategoryStyle(color)}
            >
              <h2 class="mb-4 flex flex-wrap items-baseline justify-between text-xl text-(--category-color) dark:text-(--category-color-dark)">
                <a
                  href={`${categoryBasePath}/${slug}`}
                  class="block transition-transform hover:scale-[1.02]"
                  aria-label={`${categoryName} (${postCount} posts)`}
                >
                  {categoryName}
                </a>
                <span class="text-foreground-primary/80 xs:text-sm text-xs font-normal">
                  {t('postCount', { count: postCount })}
                </span>
              </h2>
              {subcategories && Object.keys(subcategories).length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {Object.entries(subcategories!).map(([subSlug, sub]) => {
                    const subName = sub.name[lang] ?? sub.name.en ?? Object.values(sub.name)[0];

                    return (
                      <a
                        href={`${categoryBasePath}/${subSlug}`}
                        class="rounded-full border border-(--subcategory-color)/50 bg-(--subcategory-color)/10 px-2.5 py-1 text-xs font-medium text-(--subcategory-color) transition-transform hover:scale-[1.02] dark:border-(--subcategory-color-dark)/80 dark:bg-(--subcategory-color-dark)/20 dark:text-(--subcategory-color-dark)"
                        style={{
                          '--subcategory-color': sub.color.light,
                          '--subcategory-color-dark': sub.color.dark,
                        }}
                        aria-label={`${subName} (${sub.postCount ?? 0} posts)`}
                      >
                        {subName}
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>
    )
  }
</SiteLayout>
