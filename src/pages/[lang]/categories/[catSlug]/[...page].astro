---
import PostPreviewCard from '@/components/features/post/preview/PostPreviewCard.astro';
import Pagination from '@/components/ui/Pagination.astro';
import PostListLayout from '@/layouts/PostListLayout.astro';
import {
  getAllCategoryByPosts,
  getCategoryBySlug,
  getCategoryStyle,
  isPostInCategory,
} from '@/lib/categories';
import { createTranslator, resolveLanguage } from '@/lib/i18n';
import { paginate } from '@/lib/pagination';
import { withLocalePrefix } from '@/lib/paths';
import { getPostsMeta } from '@/lib/posts';
import { DEFAULT_POSTS_PER_PAGE, SUPPORTED_LANGUAGES } from '@/config';
import type { Category, CategoryInfo, PostMeta } from '@/types';

interface Props {
  items: PostMeta[];
  currPage: number;
  totalPages: number;
  totalItems: number;
  mainCategory: Category;
  subCategory: CategoryInfo | null;
  hasSubCategory: boolean;
}

export const getStaticPaths = async () => {
  const paths: { params: Record<string, string | undefined>; props: Props }[] = [];

  for (const lang of SUPPORTED_LANGUAGES) {
    const posts = await getPostsMeta(lang);
    const categories = getAllCategoryByPosts(posts);
    const allCatSlugs = categories.flatMap((cat) => [
      cat.slug,
      ...Object.keys(cat.subcategories ?? {}),
    ]);

    for (const catSlug of allCatSlugs) {
      const resolved = getCategoryBySlug(catSlug, categories, 'all');
      if (!resolved) continue;

      const isSubCat = 'parentSlug' in resolved && !!resolved.parentSlug;
      const subCategory = isSubCat ? (resolved as CategoryInfo) : null;
      const mainCategory =
        isSubCat && subCategory?.parentSlug
          ? getCategoryBySlug(subCategory.parentSlug, categories, 'main')
          : resolved;
      if (!mainCategory || !('subcategories' in mainCategory)) continue;

      const subcats = (mainCategory as Category).subcategories ?? {};
      const filteredPosts = posts.filter((post) => {
        if (subCategory) return isPostInCategory(post, subCategory.name, subCategory.slug);
        return (
          isPostInCategory(post, mainCategory.name, mainCategory.slug) ||
          Object.values(subcats).some((sub) => isPostInCategory(post, sub.name, sub.slug))
        );
      });

      const totalPages = Math.ceil(filteredPosts.length / DEFAULT_POSTS_PER_PAGE) || 1;
      for (let p = 1; p <= totalPages; p++) {
        const { items, currPage, totalPages: tp, totalItems } = paginate(filteredPosts, p);
        paths.push({
          params: { lang, catSlug, page: p === 1 ? undefined : String(p) },
          props: {
            items,
            currPage,
            totalPages: tp,
            totalItems,
            mainCategory,
            subCategory,
            hasSubCategory: isSubCat,
          },
        });
      }
    }
  }
  return paths;
};

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'CategoriesPage');
const tNav = createTranslator(lang, 'nav');

const link = (href: string) => withLocalePrefix(href, lang);

const {
  items: paginatedPosts,
  currPage: safePage,
  totalPages,
  totalItems,
  mainCategory,
  subCategory,
  hasSubCategory,
} = Astro.props as Props;
const catSlug = Astro.params.catSlug as string;

const pageTitle =
  hasSubCategory && subCategory
    ? (subCategory.name[lang] ?? subCategory.name.en ?? Object.values(subCategory.name)[0])
    : (mainCategory.name[lang] ?? mainCategory.name.en ?? Object.values(mainCategory.name)[0]);

const subcategories: Record<string, CategoryInfo> = mainCategory.subcategories ?? {};

const prevCatHref =
  safePage === 2
    ? withLocalePrefix(`/categories/${catSlug}`, lang)
    : withLocalePrefix(`/categories/${catSlug}/${safePage - 1}`, lang);
const nextCatHref = withLocalePrefix(`/categories/${catSlug}/${safePage + 1}`, lang);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeBreadcrumbUrl = new URL(withLocalePrefix('/', lang), siteUrl).href;
const categoriesBreadcrumbUrl = new URL(withLocalePrefix('/categories', lang), siteUrl).href;
const mainCatBreadcrumbUrl = new URL(
  withLocalePrefix(`/categories/${mainCategory.slug}`, lang),
  siteUrl
).href;
const breadcrumbItems = [
  { position: 1, name: tNav('home'), item: homeBreadcrumbUrl },
  { position: 2, name: t('breadcrumb.categories'), item: categoriesBreadcrumbUrl },
  { position: 3, name: mainCategory.name[lang], item: mainCatBreadcrumbUrl },
];
if (hasSubCategory && subCategory) {
  const subCatBreadcrumbUrl = new URL(
    withLocalePrefix(`/categories/${subCategory.slug}`, lang),
    siteUrl
  ).href;
  breadcrumbItems.push({ position: 4, name: subCategory.name[lang], item: subCatBreadcrumbUrl });
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map(({ position, name, item }) => ({
    '@type': 'ListItem',
    position,
    name,
    item,
  })),
};
---

<PostListLayout title={pageTitle} noindex={safePage > 1}>
  {safePage > 1 && <link slot="head" rel="prev" href={prevCatHref} />}
  {safePage < totalPages && <link slot="head" rel="next" href={nextCatHref} />}
  <nav
    slot="header"
    class="flex items-baseline justify-between text-sm text-gray-400 dark:text-gray-300"
  >
    <div class="flex items-center space-x-2">
      <a
        href={withLocalePrefix('/categories', lang)}
        class="hover:text-foreground-primary transition-colors"
      >
        {t('breadcrumb.categories')}
      </a>
      <span>/</span>
      <a
        href={withLocalePrefix(`/categories/${mainCategory.slug}`, lang)}
        class="font-medium text-(--category-color)"
        style={getCategoryStyle(mainCategory.color)}
      >
        {mainCategory.name[lang]}
      </a>
      {
        hasSubCategory && subCategory && (
          <>
            <span>/</span>
            <a
              href={withLocalePrefix(`/categories/${subCategory.slug}`, lang)}
              class="font-medium text-(--category-color)"
              style={getCategoryStyle(subCategory.color)}
            >
              {subCategory.name[lang]}
            </a>
          </>
        )
      }
    </div>
    <span class="text-gray-500 select-none dark:text-gray-400">
      {t('postCount', { count: totalItems })}
    </span>
  </nav>
  {
    !hasSubCategory && Object.keys(subcategories).length > 0 && (
      <div slot="subheader" class="flex flex-wrap items-center gap-2 text-xs">
        {Object.entries(subcategories).map(([slug, sub]) => (
          <a
            href={withLocalePrefix(`/categories/${slug}`, lang)}
            class="rounded-full border border-(--subcategory-color)/50 bg-(--subcategory-color)/10 px-2.5 py-1 transition hover:brightness-110 dark:border-(--subcategory-color-dark)/80 dark:bg-(--subcategory-color-dark)/20"
            style={{
              '--subcategory-color': sub.color.light,
              '--subcategory-color-dark': sub.color.dark,
            }}
          >
            <span class="text-(--subcategory-color) dark:text-(--subcategory-color-dark)">
              {sub.name[lang]}
            </span>
          </a>
        ))}
      </div>
    )
  }
  <section class="space-y-4">
    {paginatedPosts.map((post) => <PostPreviewCard post={post} lang={lang} hideImage />)}
  </section>
  {
    totalPages > 1 && (
      <Pagination
        slot="pagination"
        t={t}
        link={link}
        basePath={`/categories/${catSlug}`}
        currPage={safePage}
        totalPages={totalPages}
      />
    )
  }
</PostListLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
