---
import PostLayout from '@/layouts/PostLayout.astro';
import { resolveLanguage } from '@/lib/i18n';
import { getPost, getPostAvailableLangs, getPostMetaBySlug, getPostsMeta } from '@/lib/posts';
import { SUPPORTED_LANGUAGES } from '@/config';

export const getStaticPaths = async () => {
  const paths: { params: Record<string, string> }[] = [];
  for (const lang of SUPPORTED_LANGUAGES) {
    const posts = await getPostsMeta(lang);
    for (const post of posts) paths.push({ params: { lang, slug: post.slug } });
  }
  return paths;
};

const { lang: rawLang, slug } = Astro.params as { lang: string; slug: string };
const lang = resolveLanguage(rawLang);

if (!slug) return Astro.redirect('/404', 404);

const postMeta = await getPostMetaBySlug(lang, slug);
if (!postMeta) return Astro.redirect('/404', 404);

const isProtected = !!postMeta.protected;
const post = await getPost(lang, slug);
const availableLangs = await getPostAvailableLangs(slug);
const otherLangs = availableLangs.filter((l) => l !== lang);
const displayPost = post ?? postMeta;
const postContent = post?.rendered?.Content ?? null;
---

<PostLayout
  lang={lang}
  post={displayPost}
  otherLangs={otherLangs}
  isProtected={isProtected}
  content={postContent}
  headings={post?.headings ?? []}
/>
