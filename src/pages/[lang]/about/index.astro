---
import { Link } from '@lucide/astro';

import { CONFIG } from '@/config';
import youtubes from '@/data/youtubes';
import { createTranslator, getLangStaticPaths, resolveLanguage } from '@/lib/i18n';

import { Image, Images } from '@/components/mdx';
import DecorativeImage from '@/components/ui/DecorativeImage.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';

import aboutImg from '@/assets/images/about-illustration.webp';
import booImg from '@/assets/images/cat-boo.webp';
import huamiAndBooImg from '@/assets/images/cat-huami-and-boo.webp';
import huamiImg from '@/assets/images/cat-huami.webp';

export const getStaticPaths = getLangStaticPaths;

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'AboutPage');
const videos = Object.values(youtubes);
---

<SiteLayout title={t('title')} description={t('description')}>
  <div class="bg-surface-secondary relative rounded-xl pb-10 shadow lg:pb-24">
    <DecorativeImage
      src={aboutImg.src}
      class="absolute -right-8 -bottom-8 z-10 w-[50vw] md:-right-4 md:w-80"
    />
    <div class="relative px-4 py-6 md:px-6">
      <div
        class="mb-6 flex flex-wrap items-end justify-between gap-4 border-b border-gray-100 pb-4 dark:border-gray-800/80"
      >
        <h2>{t('title')}</h2>
        <ExternalLink
          href={CONFIG.siteInfo.resumeLink}
          noline
          class="group relative inline-flex items-center gap-2.5 overflow-hidden rounded-xl border border-pink-100/90 bg-linear-to-r from-pink-50/40 to-rose-50/30 px-4 py-2 text-xs font-semibold shadow-sm backdrop-blur-md transition-all duration-300 hover:scale-[1.02] hover:border-pink-300 hover:shadow-md hover:shadow-pink-100/30 dark:border-pink-900/40 dark:bg-linear-to-r dark:from-pink-950/15 dark:to-rose-950/10 dark:hover:border-pink-800 dark:hover:shadow-none"
        >
          <span
            class="pointer-events-none absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-white/40 to-transparent transition-transform duration-1000 ease-out group-hover:translate-x-full dark:via-white/10"
          ></span>
          <span class="relative flex size-1.5">
            <span
              class="pointer-events-none absolute inline-flex size-full animate-ping rounded-full bg-pink-400 opacity-75"
            ></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-pink-500"></span>
          </span>
          <span
            class="bg-linear-to-r from-pink-600 to-rose-600 bg-clip-text text-transparent transition-colors group-hover:from-pink-500 group-hover:to-rose-500 dark:from-pink-300 dark:to-rose-300 dark:group-hover:from-pink-200 dark:group-hover:to-rose-200"
          >
            {t('resumeSubtitle')}
          </span>
          <Link
            size={12}
            class="text-pink-600 opacity-70 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 dark:text-pink-400"
          />
        </ExternalLink>
      </div>
      <section class="space-y-4">
        <h3 class="heading -ml-4 md:-ml-6">{t('intro')}</h3>
        <ul class="list-inside list-disc leading-7">
          <li>{t('personalInfo.job')}</li>
          <li>{t('personalInfo.mbti')}</li>
          <li>{t('personalInfo.hobby')}</li>
          <li>{t('personalInfo.hobby2')}</li>
          <li>{t('personalInfo.hobby3')}</li>
        </ul>
        <div class="space-y-2">
          <p>{t('vlogIntro')}</p>
          <ExternalLink href={CONFIG.siteInfo.socialLinks.youtube} noline>
            &gt;&gt;&gt;
            <span class="px-2 group-hover:font-medium">YT</span>
            &lt;&lt;&lt;
          </ExternalLink>
          <section
            class="flex flex-wrap gap-4"
            role="region"
            aria-label={`${CONFIG.siteInfo.name}'s youtube videos`}
          >
            {
              videos.map((video) => (
                <div class="max-w-60 transition-transform duration-200 ease-out hover:-translate-y-1 hover:-rotate-1">
                  <figure>
                    <iframe
                      src={video.url}
                      title={video.title}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      class="aspect-video size-full rounded"
                    />
                  </figure>
                  <div class="py-2">
                    <h4 class="truncate text-sm font-medium">{video.title}</h4>
                    <time class="text-xs opacity-70">{video.date}</time>
                  </div>
                </div>
              ))
            }
          </section>
        </div>
      </section>
      <section class="relative mt-10 space-y-2.5">
        <h3 class="heading -ml-4 md:-ml-6">{t('title_3')}</h3>
        <ExternalLink
          href={`mailto:${CONFIG.siteInfo.email}`}
          class="relative inline-block text-xl font-medium text-pink-600 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 dark:text-pink-300"
          noline
        >
          {CONFIG.siteInfo.email}
        </ExternalLink>
      </section>
      <section class="mt-10 space-y-4">
        <h3 class="heading -ml-4 md:-ml-6">{t('cats.title')}</h3>
        <p>{t('cats.description')}</p>
        <Images
          images={[
            {
              src: huamiImg.src,
              alt: t('cats.huami.alt'),
              title: t('cats.huami.title'),
            },
            {
              src: booImg.src,
              alt: t('cats.boo.alt'),
              title: t('cats.boo.title'),
            },
          ]}
          align="left"
        />
        <Image src={huamiAndBooImg.src} alt={t('cats.both.alt')} align="left" width={520} />
      </section>
    </div>
  </div>
</SiteLayout>
