---
export const prerender = true;

import { Link } from '@lucide/astro';

import { CONFIG } from '@/config';
import youtubes from '@/data/youtubes';
import { createTranslator, getLangStaticPaths, resolveLanguage } from '@/lib/i18n';

import { Image, Images } from '@/components/mdx';
import DecorativeImage from '@/components/ui/DecorativeImage.astro';
import ExternalLink from '@/components/ui/ExternalLink';
import SiteLayout from '@/layouts/SiteLayout.astro';

import aboutImg from '@/assets/images/about-illustration.webp';
import arrowsImg from '@/assets/images/arrows-illustration.webp';
import booImg from '@/assets/images/cat-boo.webp';
import huamiAndBooImg from '@/assets/images/cat-huami-and-boo.webp';
import huamiImg from '@/assets/images/cat-huami.webp';

export const getStaticPaths = getLangStaticPaths;

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'AboutPage');
const videos = Object.values(youtubes);
---

<SiteLayout title={t('title')} description={t('description')}>
  <div class="bg-surface-secondary relative rounded-xl pb-10 shadow lg:pb-24">
    <DecorativeImage
      src={aboutImg.src}
      class="absolute -right-8 -bottom-8 z-30 w-[50vw] md:-right-4 md:w-80"
    />
    <div class="relative z-20 px-8 py-6">
      <h2>{t('title')}</h2>
      <section class="mt-6 space-y-4">
        <h3 class="heading -ml-8">{t('intro')}</h3>
        <ul class="list-inside list-disc leading-7">
          <li>{t('personalInfo.job')}</li>
          <li>{t('personalInfo.mbti')}</li>
          <li>{t('personalInfo.hobby')}</li>
          <li>{t('personalInfo.hobby2')}</li>
          <li>{t('personalInfo.hobby3')}</li>
        </ul>
        <div class="space-y-2">
          <p>{t('vlogIntro')}</p>
          <ExternalLink href={CONFIG.siteInfo.socialLinks.youtube} noline>
            &gt;&gt;&gt;
            <span class="px-2 group-hover:font-medium">YT</span>
            &lt;&lt;&lt;
          </ExternalLink>
          <section
            class="flex flex-wrap gap-4"
            role="region"
            aria-label={`${CONFIG.siteInfo.name}'s youtube videos`}
          >
            {
              videos.map((video) => (
                <div class="max-w-60 transition-transform duration-200 ease-out hover:-translate-y-1 hover:-rotate-1">
                  <figure>
                    <iframe
                      src={video.url}
                      title={video.title}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      class="aspect-video size-full rounded"
                    />
                  </figure>
                  <div class="py-2">
                    <h4 class="truncate text-sm font-medium">{video.title}</h4>
                    <time class="text-xs opacity-70">{video.date}</time>
                  </div>
                </div>
              ))
            }
          </section>
        </div>
      </section>
      <section class="mt-10 space-y-4">
        <h3 class="heading -ml-8 flex items-center gap-2">
          {t('title_2')}
          <ExternalLink href={CONFIG.siteInfo.resumeLink} noline><Link size={18} /></ExternalLink>
        </h3>
      </section>
      <section class="relative mt-10 space-y-2.5">
        <h3 class="heading -ml-8">{t('title_3')}</h3>
        <ExternalLink
          href={`mailto:${CONFIG.siteInfo.email}`}
          className="relative inline-block text-xl font-medium text-pink-600 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 dark:text-pink-300"
          noline
        >
          {CONFIG.siteInfo.email}
        </ExternalLink>
        <p>
          這裡也可以找到我：<a
            href="https://www.facebook.com/kir4che/"
            target="_blank"
            class="relative inline-block text-xl font-medium text-blue-600 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 dark:text-blue-400"
            >FB</a
          ><span class="text-xs">（雖然還沒開始經營）</span>
        </p>
        <div class="absolute bottom-8 left-48 -z-10">
          <div class="animate-bounce">
            <DecorativeImage src={arrowsImg.src} class="w-24 rotate-6" />
          </div>
        </div>
      </section>
      <section class="mt-10 space-y-4">
        <h3 class="heading -ml-8">曬貓</h3>
        <p>家裡養了兩隻貓貓－花咪、小晡，霹靂可愛 (*´∀`)~🩷</p>
        <Images
          images={[
            {
              src: huamiImg.src,
              alt: '花咪的照片',
              title: '花咪',
            },
            {
              src: booImg.src,
              alt: '小晡的照片',
              title: '小晡',
            },
          ]}
          align="left"
        />
        <Image src={huamiAndBooImg.src} alt="花咪和小晡的照片" align="left" width={520} />
      </section>
    </div>
  </div>
</SiteLayout>
