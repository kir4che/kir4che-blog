---
export const prerender = true;

import PostPreviewList from '@/components/features/post/preview/PostPreviewList.astro';
import Pagination from '@/components/ui/Pagination.astro';
import { DEFAULT_POSTS_PER_PAGE, SUPPORTED_LANGUAGES } from '@/config';
import PostListLayout from '@/layouts/PostListLayout.astro';
import { createTranslator, resolveLanguage } from '@/lib/i18n';
import { paginate } from '@/lib/pagination';
import { withLocalePrefix } from '@/lib/paths';
import { getPostsInfo } from '@/lib/posts';
import { getTagDisplayName, getTagsByPosts } from '@/lib/tags';
import { slugify } from '@/utils/slug';

export async function getStaticPaths() {
  const paths: { params: { lang: string; tagSlug: string; page: string | undefined } }[] = [];

  for (const lang of SUPPORTED_LANGUAGES) {
    const posts = await getPostsInfo(lang);
    const tags = getTagsByPosts(posts, undefined, lang);

    for (const tag of tags) {
      const taggedPosts = posts.filter((post) =>
        post.tags.some((raw) => slugify(raw) === tag.slug)
      );
      const totalPages = Math.ceil(taggedPosts.length / DEFAULT_POSTS_PER_PAGE) || 1;

      for (let p = 1; p <= totalPages; p++) {
        paths.push({ params: { lang, tagSlug: tag.slug, page: p === 1 ? undefined : String(p) } });
      }
    }
  }

  return paths;
}

const lang = resolveLanguage(Astro.params.lang);
const t = createTranslator(lang, 'TagsPage');
const link = (href: string) => withLocalePrefix(href, lang);

const tagSlug = Astro.params.tagSlug as string;
const page = Astro.params.page ? parseInt(Astro.params.page, 10) : 1;

const allPosts = await getPostsInfo(lang);
const taggedPosts = allPosts.filter((post) => post.tags.some((raw) => slugify(raw) === tagSlug));

const { items, currPage, totalPages, totalItems } = paginate(taggedPosts, page);

const originalTagName = taggedPosts[0]?.tags.find((t) => slugify(t) === tagSlug) ?? tagSlug;

const tagName = getTagDisplayName(tagSlug, originalTagName, lang);
---

<PostListLayout title={`#${tagName}`}>
  <h1 slot="header" class="mb-4 flex items-baseline justify-between">
    <span># {tagName}</span>
    <span class="text-foreground-primary/80 text-sm font-normal">
      {t('postCount', { count: totalItems ?? 0 })}
    </span>
  </h1>
  <section class="space-y-4">
    {items.map((post) => <PostPreviewList post={post} lang={lang} />)}
  </section>
  {
    totalPages > 1 && (
      <Pagination
        slot="pagination"
        t={t}
        link={link}
        basePath={`/tags/${tagSlug}`}
        currPage={currPage}
        totalPages={totalPages}
      />
    )
  }
</PostListLayout>
