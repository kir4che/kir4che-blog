---
import LocalizedLink from '@/components/ui/LocalizedLink.astro';
import { stripLocalePrefix } from '@/lib/paths';
import type { Translator } from '@/types';
import { normalizePathname } from '@/utils/path';

interface NavbarProps {
  t: Translator;
}

const { t } = Astro.props as NavbarProps;

const isActive = (href: string) => {
  const currPath = normalizePathname(stripLocalePrefix(Astro.url.pathname));
  const targetPath = normalizePathname(stripLocalePrefix(href));
  return currPath === targetPath;
};

const navItems = [
  { href: '/', label: t('home') },
  { href: '/about', label: t('about') },
  { href: '/categories', label: t('categories') },
  { href: '/tags', label: t('tags') },
  { href: '/archives', label: t('archives') },
];
---

<nav class="ml-auto">
  <ul class="flex gap-4">
    {
      navItems
        .filter((item) => item.label)
        .map(({ href, label }) => (
          <li>
            <LocalizedLink
              href={href}
              class:list={[
                'hover:text-primary inline-block text-sm',
                {
                  'text-primary font-medium': isActive(href),
                },
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </LocalizedLink>
          </li>
        ))
    }
  </ul>
</nav>
