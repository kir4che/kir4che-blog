---
import LocalizedLink from '@/components/ui/LocalizedLink';
import { getLocaleFromUrl } from '@/lib/i18n';
import { stripLocalePrefix } from '@/lib/paths';
import type { Translator } from '@/types';
import { cn } from '@/utils/cn';
import { normalizePathname } from '@/utils/path';

interface Props {
  t: Translator;
}

const { t } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);

const isActive = (href: string) => {
  const currPath = normalizePathname(stripLocalePrefix(Astro.url.pathname));
  const targetPath = normalizePathname(stripLocalePrefix(href));
  return currPath === targetPath;
};

const navItems = [
  { href: '/', label: t('home') },
  { href: '/about', label: t('about') },
  { href: '/categories', label: t('categories') },
  { href: '/tags', label: t('tags') },
  { href: '/archives', label: t('archives') },
];
---

<nav class="ml-auto">
  <ul class="-mb-0.5 flex items-center gap-3 sm:gap-4">
    {
      navItems
        .filter((item) => item.label)
        .map(({ href, label }) => (
          <li>
            <LocalizedLink
              href={href}
              lang={lang}
              className={cn(
                'hover:text-primary relative inline-block pb-1 text-sm transition-colors',
                isActive(href)
                  ? 'text-primary font-medium after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:rounded-full after:bg-pink-500 dark:after:bg-pink-400'
                  : 'after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:scale-x-0 after:rounded-full after:bg-pink-400/60 after:transition-transform hover:after:scale-x-100'
              )}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </LocalizedLink>
          </li>
        ))
    }
  </ul>
</nav>
