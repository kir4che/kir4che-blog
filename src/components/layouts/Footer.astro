---
import GlobalLangMenu from '@/components/ui/GlobalLangMenu.astro';
import ThemeToggle from '@/components/ui/ThemeToggle';
import { CONFIG } from '@/config';
import { createTranslator } from '@/lib/i18n';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const tSettings = createTranslator(lang, 'settings');
---

<footer class="flex-between py-6">
  <div class="flex items-center gap-x-3 md:hidden">
    <ThemeToggle
      client:load
      translations={{
        light: tSettings('theme.light'),
        dark: tSettings('theme.dark'),
      }}
    />
    <GlobalLangMenu id="global-lang-menu-footer" />
  </div>
  <p class="text-xs text-gray-400">
    © 2026 {CONFIG.siteInfo.name}
    <span class="text-pink-400 dark:text-pink-500">♥</span>
  </p>
</footer>
