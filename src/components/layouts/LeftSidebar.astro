---
import GithubIcon from '@/assets/icons/github.svg';
import YoutubeIcon from '@/assets/icons/youtube.svg';
import AvatarImage from '@/assets/images/avatar.webp';
import ExternalLink from '@/components/ui/ExternalLink';
import GlobalLangMenu from '@/components/ui/GlobalLangMenu.astro';
import LocalizedLink from '@/components/ui/LocalizedLink';
import ThemeToggle from '@/components/ui/ThemeToggle';
import { CONFIG } from '@/config';
import { createTranslator } from '@/lib/i18n';
import type { Language, Translator } from '@/types';

interface Props {
  t: Translator;
  lang: Language;
}

const { t, lang } = Astro.props;
const tSettings = createTranslator(lang, 'settings');

const socialLinks = [
  {
    label: 'GitHub',
    href: CONFIG.siteInfo.socialLinks.github,
    Icon: GithubIcon,
    color: 'bg-gray-800 dark:bg-gray-700',
  },
  {
    label: 'YouTube',
    href: CONFIG.siteInfo.socialLinks.youtube,
    Icon: YoutubeIcon,
    color: 'bg-red-500 dark:bg-red-700',
  },
];
---

<aside
  class="flex w-full pt-4 pb-2 md:sticky md:top-0 md:min-h-screen md:w-40 md:flex-col md:self-start md:pt-8 md:pr-4 lg:w-45 lg:pb-6"
>
  <div class="flex gap-x-3 max-md:flex-1 max-md:items-center md:flex-col">
    <div class="avatar relative size-16 md:size-28">
      <LocalizedLink href="/" lang={lang}>
        <div
          class="animate-blob relative h-full w-full overflow-hidden rounded-[30%_70%_53%_47%/26%_46%_54%_74%] will-change-[border-radius]"
        >
          <img
            src={AvatarImage.src}
            alt="Avatar"
            width={96}
            height={96}
            onerror="this.onerror=null;this.src='/images/cover-fallback_sm.webp';"
          />
        </div>
      </LocalizedLink>
    </div>
    <div class="mt-2">
      <h1 class="text-lg font-semibold tracking-tight">{t('name')}</h1>
      <p class="text-[13px]/5 font-medium tracking-wide text-gray-400 dark:text-gray-500">
        {t('subtitle')}
      </p>
    </div>
  </div>
  <ul class="mt-3 flex gap-x-2.5">
    {
      socialLinks.map(({ label, href, Icon, color }) => (
        <li>
          <ExternalLink href={href} title={label}>
            <span
              class={`flex-center size-7 rounded-full ${color} p-1.25 transition-transform duration-200 hover:scale-110`}
            >
              <Icon class="size-full fill-white text-white" />
            </span>
            <span class="sr-only">{label}</span>
          </ExternalLink>
        </li>
      ))
    }
  </ul>
  <div class="mt-auto hidden flex-col gap-y-3 pt-6 text-sm md:flex">
    <GlobalLangMenu id="global-lang-menu-leftsidebar" />
    <ThemeToggle
      client:load
      translations={{
        light: tSettings('theme.light'),
        dark: tSettings('theme.dark'),
      }}
    />
  </div>
</aside>
