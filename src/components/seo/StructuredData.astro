---
import { CONFIG, DEFAULT_LANGUAGE, LANGUAGE_TO_LOCALE_MAP } from '@/config';
import { getLocaleFromUrl } from '@/lib/i18n';

interface Props {
  pageTitle?: string;
  pageDescription?: string;
}

type JsonLd = Record<string, unknown>;

const { pageTitle, pageDescription } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const locale = LANGUAGE_TO_LOCALE_MAP[lang];

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const siteOrigin = siteUrl.toString().replace(/\/+$/, '');

// 取得社群連結，為了讓 Google 知道部落格與這些連結的關聯。
const sameAs = Object.values(CONFIG.siteInfo.socialLinks).filter(Boolean) as string[];

const alternateName =
  CONFIG.siteInfo.blog.siteName?.[lang] ?? CONFIG.siteInfo.blog.siteName?.[DEFAULT_LANGUAGE];

const blogTitle =
  CONFIG.siteInfo.blog.title?.[lang] ?? CONFIG.siteInfo.blog.title?.[DEFAULT_LANGUAGE];

const blogDescription =
  CONFIG.siteInfo.blog.description?.[lang] ?? CONFIG.siteInfo.blog.description?.[DEFAULT_LANGUAGE];

const pagePath = Astro.url.pathname;
const pageUrl = pagePath ? `${siteOrigin}${pagePath}` : siteOrigin;

const organizationId = `${siteOrigin}/#organization`;
const personId = `${siteOrigin}/#person`;
const websiteId = `${siteOrigin}/#website`;

const websiteEntry: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteOrigin,
  name: blogTitle ?? CONFIG.siteInfo.name,
};

const entries: JsonLd[] = [
  // Organization（供 Google Knowledge Panel 用）
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    url: siteOrigin,
    name: CONFIG.siteInfo.name,
    alternateName,
    logo: `${siteOrigin}/images/avatar.webp`,
    sameAs,
  },
  // Person
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: CONFIG.siteInfo.name,
    url: siteOrigin,
    sameAs,
  },
  websiteEntry,
  // WebPage（綁定到 WebSite）
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle ?? blogTitle ?? CONFIG.siteInfo.name,
    description: pageDescription ?? blogDescription,
    inLanguage: locale,
    isPartOf: {
      '@type': 'WebSite',
      '@id': websiteId,
    },
  },
];

const structuredDataScripts = entries.map((entry) => ({
  type: 'application/ld+json',
  content: JSON.stringify(entry),
}));
---

{
  structuredDataScripts.map((script) => (
    <script type={script.type} is:inline set:html={script.content} />
  ))
}
