---
import type { MDXContent as MDXContentType } from 'astro';

interface Props {
  id?: string;
  Content: MDXContentType;
  extraComponents?: Record<string, unknown>;
}

const { id, Content, extraComponents } = Astro.props;
---

<section id={id} class="mdx-content">
  <Content components={extraComponents} />
</section>
