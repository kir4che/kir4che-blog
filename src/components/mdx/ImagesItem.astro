---
import CustomImage from '@/components/mdx/Image.astro';
import CustomVideo from '@/components/mdx/Video.astro';
import type { MediaItem } from '@/types';
import { cn } from '@/utils/cn';

interface ImagesItemProps {
  item: MediaItem;
  singleColumn: boolean;
  resolvedMinWidth?: string;
  resolvedHeight?: string;
  resolvedMinHeight?: string;
  resolvedMaxHeight?: string;
}

const {
  item,
  singleColumn,
  resolvedMinWidth,
  resolvedHeight,
  resolvedMinHeight,
  resolvedMaxHeight,
} = Astro.props as ImagesItemProps;

const effectiveMinHeight = resolvedMinHeight ?? '200px';
const effectiveMaxHeight = resolvedMaxHeight ?? '400px';

const rawSpan = Number(item.colSpan);
const span = singleColumn || !Number.isFinite(rawSpan) || rawSpan <= 0 ? 1 : rawSpan;
const hasFixedHeight = Boolean(resolvedHeight || effectiveMinHeight || effectiveMaxHeight);

const style = {
  '--item-min-width': singleColumn ? '100%' : (resolvedMinWidth ?? '0px'),
  '--gallery-min-height': resolvedHeight ?? effectiveMinHeight,
  '--gallery-max-height': effectiveMaxHeight,

  ...(singleColumn
    ? {
        flex: '0 0 auto',
        width: '100%',
      }
    : {
        flex: `1 1 min(100%, calc(var(--item-min-width) * ${span}))`,
        minWidth: `min(100%, calc(var(--item-min-width) * ${span}))`,
        maxWidth: '100%',
      }),
} as Record<string, string | number | undefined>;

const galleryImageClass =
  'w-full h-full block object-cover min-h-(--gallery-min-height) max-h-(--gallery-max-height)';
const imageWrapClass = 'h-full';
const videoStyle = { width: '100%', height: '100%' } as Record<string, string>;
---

<div
  data-images-item
  class={cn(
    'transition-all duration-300',
    hasFixedHeight && 'min-h-(--gallery-min-height)',
    hasFixedHeight && 'max-h-(--gallery-max-height)',
    'min-w-(--item-min-width)',
    'overflow-hidden',
    singleColumn ? 'w-full flex-none' : 'lg:min-w-0'
  )}
  style={style}
>
  {
    item.type === 'video' ? (
      <CustomVideo
        {...item}
        width="100%"
        height="100%"
        data-images-media
        style={videoStyle}
        class={cn('size-full overflow-hidden', item.className)}
      />
    ) : (
      <CustomImage
        {...item}
        width="100%"
        height="100%"
        imgClass={galleryImageClass}
        imgWrapClass={imageWrapClass}
        data-images-media
        class={cn('size-full overflow-hidden', item.className)}
      />
    )
  }
</div>
