---
interface StarRatingProps {
  type: 'star' | 'heart';
  rating: number; // 0.5 ~ 5.0
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { type = 'star', rating, size = 'sm' } = Astro.props as StarRatingProps;

const maskShape = {
  star: 'mask-star-2',
  heart: 'mask-heart',
}[type];

const filledColor = {
  star: 'bg-yellow-400',
  heart: 'bg-red-400',
}[type];

const sizeClass = {
  sm: 'rating-sm',
  md: 'rating-md',
  lg: 'rating-lg',
}[size];

const steps = Array.from({ length: 10 }, (_, index) => {
  const value = (index + 1) * 0.5;
  const isHalf = index % 2 === 0;
  const isFilled = value <= rating;

  return { value, isHalf, isFilled };
});
---

<div
  class:list={['rating rating-half mt-1 mb-2', sizeClass]}
  role="img"
  aria-label={`rating: ${rating}/5`}
>
  {
    steps.map(({ value, isHalf, isFilled }) => (
      <div
        class:list={[
          'mask',
          maskShape,
          {
            'mask-half-1': isHalf,
            'mask-half-2 mr-1': !isHalf,
            [filledColor]: isFilled,
            'bg-gray-200 dark:bg-gray-700': !isFilled,
          },
        ]}
        aria-current={rating === value}
      />
    ))
  }
</div>
