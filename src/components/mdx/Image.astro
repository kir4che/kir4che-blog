---
import FigureShell from '@/components/mdx/FigureShell.astro';

interface ImageProps {
  src: string;
  alt?: string;
  title?: string;
  width?: string | number;
  height?: string | number;
  align?: 'left' | 'center' | 'right';
  objPos?: 'top' | 'bottom' | 'center';
  sizes?: string;
  originalWidth?: number;
  originalHeight?: number;
  fallbackSrc?: string;
  class?: string;
  imgClass?: string;
  imgWrapClass?: string;
  [key: string]: any;
}

const {
  src,
  alt = '',
  title,
  width,
  height,
  align = 'center',
  objPos = 'center',
  sizes,
  originalWidth,
  originalHeight,
  fallbackSrc = '/images/cover-fallback_lg.webp',
  class: className,
  imgClass,
  imgWrapClass,
  ...rest
} = Astro.props as ImageProps;

const normalizedHeight =
  typeof height === 'string' && height.trim().toLowerCase() === 'auto' ? undefined : height;

const objectPosition = {
  top: 'object-top',
  center: 'object-center',
  bottom: 'object-bottom',
}[objPos];

const hasNumericDims =
  typeof width === 'number' &&
  typeof normalizedHeight === 'number' &&
  width > 0 &&
  normalizedHeight > 0;

const useFill = !hasNumericDims;

const renderWidth = hasNumericDims ? width : originalWidth;
const renderHeight = hasNumericDims ? normalizedHeight : originalHeight;

// 不同寬度時要載入多大的圖片
const computedSizes =
  sizes ??
  (useFill
    ? '(max-width: 768px) 100vw, (max-width: 1280px) 80vw, 800px'
    : renderWidth
      ? `(max-width: ${renderWidth}px) 100vw, ${renderWidth}px`
      : '100vw');

// figure 與圖片容器的尺寸控制，避免 title 被裁。
const figureStyle = {
  '--img-width': width || (useFill ? '100%' : undefined),
  '--img-max-height': normalizedHeight
    ? `max(${typeof normalizedHeight === 'number' ? `${normalizedHeight}px` : normalizedHeight}, 400px)`
    : '400px',
} as Record<string, string | number | undefined>;

const useSmMaxWidth = typeof width !== 'undefined' && typeof width !== 'number';

const imageWrapStyle = {
  height: normalizedHeight || (useFill ? '100%' : undefined),
  aspectRatio:
    useFill && originalWidth && originalHeight ? `${originalWidth}/${originalHeight}` : undefined,
} as Record<string, string | number | undefined>;
---

<FigureShell
  align={align}
  title={title}
  class:list={[
    'relative w-full',
    {
      'sm:max-w-(--img-width)': useSmMaxWidth,
      'md:max-w-5/6': !useSmMaxWidth,
    },
  ]}
  style={figureStyle}
>
  <div
    class:list={[
      'xs:max-h-(--img-max-height) relative max-h-80 w-full overflow-hidden bg-gray-100 dark:bg-gray-800',
      imgWrapClass,
    ]}
    style={imageWrapStyle}
  >
    <img
      src={src}
      alt={alt}
      width={renderWidth || undefined}
      height={renderHeight || undefined}
      sizes={computedSizes}
      loading="lazy"
      decoding="async"
      onerror={`this.onerror=null;this.src='${fallbackSrc}';`}
      onload="this.classList.remove('opacity-0')"
      class:list={[
        'size-full object-cover opacity-0 transition-[opacity,transform] duration-500',
        objectPosition,
        imgClass,
      ]}
      {...rest}
    />
  </div>
</FigureShell>
