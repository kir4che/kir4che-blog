---
import type { LinkBuilder, Translator } from '@/types';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Props {
  t: Translator;
  link: LinkBuilder;
  basePath?: string;
  page1Path?: string;
  currPage?: number;
  totalPages: number;
}

const { t, link, basePath = '', page1Path, currPage = 1, totalPages } = Astro.props;
if (!t || !link || totalPages <= 1) return null;

const safeCurrent = Math.min(Math.max(currPage, 1), totalPages);

const MAX_VISIBLE_PAGES = 5;

type PageItem = number | 'ellipsis';

// 計算要顯示的頁碼清單
const getPageNumbers = (): PageItem[] => {
  let start = Math.max(1, safeCurrent - Math.floor(MAX_VISIBLE_PAGES / 2));
  let end = Math.min(totalPages, start + MAX_VISIBLE_PAGES - 1);

  if (end - start + 1 < MAX_VISIBLE_PAGES) start = Math.max(1, end - MAX_VISIBLE_PAGES + 1);

  const pages: PageItem[] = [];

  if (start > 1) {
    pages.push(1);
    if (start > 2) pages.push('ellipsis');
  }

  for (let i = start; i <= end; i++) pages.push(i);

  if (end < totalPages) {
    if (end < totalPages - 1) pages.push('ellipsis');
    pages.push(totalPages);
  }

  return pages;
};

const pages = getPageNumbers();

// 第 1 頁用 page1Path 或 basePath（無 /page/1 後綴），其餘用 basePath/N。
const buildPageHref = (page: number): string =>
  link(page === 1 ? (page1Path ?? basePath) : `${basePath}/${page}`);
---

<div class="mt-auto">
  <nav
    class="flex items-center justify-end gap-x-3 py-4 text-sm select-none max-lg:justify-center"
    aria-label={t('title')}
  >
    {
      safeCurrent > 1 && (
        <a href={buildPageHref(safeCurrent - 1)} aria-label={t('previous')}>
          <ChevronLeft size={18} />
        </a>
      )
    }
    {
      pages.map((page) =>
        page === 'ellipsis' ? (
          <span aria-hidden="true" class="text-foreground-primary/80">
            …
          </span>
        ) : (
          <a
            href={buildPageHref(page)}
            class:list={[
              'size-6 rounded-full text-center leading-6',
              {
                'text-foreground-secondary bg-pink-500 font-medium dark:bg-pink-300':
                  page === safeCurrent,
                'hover:bg-pink-500/30': page !== safeCurrent,
              },
            ]}
            aria-current={page === safeCurrent ? 'page' : undefined}
            aria-label={t('goToPage', { page })}
          >
            {page}
          </a>
        )
      )
    }
    {
      safeCurrent < totalPages && (
        <a href={buildPageHref(safeCurrent + 1)} aria-label={t('next')}>
          <ChevronRight size={18} />
        </a>
      )
    }
  </nav>
</div>
