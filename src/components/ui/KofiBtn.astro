---
import KofiIcon from '@/assets/icons/kofi.svg';
import ExternalLink from '@/components/ui/ExternalLink';
import { CONFIG } from '@/config';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<ExternalLink
  href={`https://ko-fi.com/${CONFIG.siteInfo.name}`}
  title={label}
  noline
  className="btn group text-foreground-secondary rounded-full bg-pink-600 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-pink-700"
>
  <KofiIcon class="size-5" />
  <span>{label}</span>
</ExternalLink>
