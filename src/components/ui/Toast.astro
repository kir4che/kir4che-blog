---
import { X } from '@lucide/astro';
---

<div
  id="toast-root"
  class="toast toast-top toast-center z-50"
  aria-live="polite"
  aria-atomic="true"
>
</div>

<template id="toast-template">
  <div
    role="alert"
    class="alert flex-between gap-2 rounded-md border-none transition-opacity duration-300 data-[variant=error]:bg-red-100 data-[variant=error]:text-red-700 data-[variant=info]:bg-blue-100 data-[variant=info]:text-blue-700 data-[variant=success]:bg-green-100 data-[variant=success]:text-green-700 data-[variant=warning]:bg-yellow-100 data-[variant=warning]:text-yellow-800 dark:data-[variant=error]:bg-red-900/50 dark:data-[variant=error]:text-red-100 dark:data-[variant=info]:bg-blue-900/50 dark:data-[variant=info]:text-blue-100 dark:data-[variant=success]:bg-green-900/50 dark:data-[variant=success]:text-green-100 dark:data-[variant=warning]:bg-yellow-900/50 dark:data-[variant=warning]:text-yellow-100"
  >
    <span data-toast-icon class="text-sm leading-none"></span>
    <span data-toast-message class="flex-1 text-sm"></span>
    <button type="button" class="hover:opacity-80" aria-label="Dismiss toast" data-toast-close>
      <X size={14} aria-hidden="true" />
    </button>
  </div>
</template>

<script is:inline>
  (() => {
    if (window.__toastInit) return;
    window.__toastInit = true;

    const root = document.getElementById('toast-root');
    const template = document.getElementById('toast-template');
    if (!root || !(template instanceof HTMLTemplateElement)) return;

    const MAX_TOASTS = 5; // 一次最多顯示的 toast 數量

    const VARIANTS = ['success', 'error', 'info', 'warning'];

    const ICONS = {
      success: '✅',
      error: '‼️',
      info: 'ℹ️',
      warning: '⚠️',
    };

    const DURATIONS = {
      success: 3000,
      info: 3000,
      warning: 4000,
      error: 5000,
    };

    const appendToast = (toast) => {
      while (root.children.length >= MAX_TOASTS) {
        root.firstElementChild?.remove();
      }
      root.appendChild(toast);
    };

    const createToast = ({ message, variant }) => {
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!(node instanceof HTMLElement)) return null;

      const v = VARIANTS.includes(variant) ? variant : 'error';
      node.dataset.variant = v;

      const text = node.querySelector('[data-toast-message]');
      const icon = node.querySelector('[data-toast-icon]');
      const close = node.querySelector('[data-toast-close]');

      if (text) text.textContent = message ?? '';
      if (icon) icon.textContent = ICONS[v] ?? '';

      const remove = () => {
        if (node.dataset.removing) return;
        node.dataset.removing = 'true';
        node.classList.add('opacity-0');
        setTimeout(() => node.remove(), 300);
      };

      if (close instanceof HTMLButtonElement) close.addEventListener('click', remove);

      const duration = DURATIONS[v];
      if (duration) setTimeout(remove, duration);

      return node;
    };

    window.addEventListener('toast', (event) => {
      const detail = event?.detail ?? {};
      if (typeof detail.message !== 'string' || !detail.message) return;

      const toast = createToast({
        message: detail.message,
        variant: detail.variant,
      });

      if (toast) appendToast(toast);
    });
  })();
</script>
