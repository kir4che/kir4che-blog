---
import { MoonStar, Sun } from '@lucide/astro';

interface Props {
  translations: {
    light: string;
    dark: string;
  };
  iconOnly?: boolean;
}

const { translations, iconOnly = false } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-label-light={translations.light}
  data-label-dark={translations.dark}
  class="hover:text-foreground-primary dark:text-foreground-primary/80 flex w-fit items-center gap-x-1.5 bg-transparent text-sm text-gray-700"
  aria-label={translations.dark}
>
  <span data-theme-icon="sun" aria-hidden="true" class="dark:hidden">
    <Sun size={16} />
  </span>
  <span data-theme-icon="moon" aria-hidden="true" class="hidden dark:block">
    <MoonStar size={16} />
  </span>
  {
    !iconOnly && (
      <span data-theme-label class="max-md:hidden">
        {translations.dark}
      </span>
    )
  }
</button>

<script>
  const syncToggle = (btn: HTMLElement, isDark: boolean) => {
    const label = btn.querySelector<HTMLElement>('[data-theme-label]');
    const labelLight = btn.dataset.labelLight ?? '';
    const labelDark = btn.dataset.labelDark ?? '';

    const nextLabel = isDark ? labelLight : labelDark;
    btn.setAttribute('aria-label', nextLabel);
    if (label) label.textContent = nextLabel;
  };

  const syncAll = () => {
    const isDark = document.documentElement.classList.contains('dark');
    document
      .querySelectorAll<HTMLElement>('[data-theme-toggle]')
      .forEach((b) => syncToggle(b, isDark));
  };

  // 點擊時切換主題
  document.addEventListener('click', (e) => {
    // 使用者可能點到子元素，所以要找到最近的按鈕元素。
    const btn = (e.target as Element).closest<HTMLElement>('[data-theme-toggle]');
    if (!btn) return;

    const next = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', next);
    localStorage.setItem('theme', next ? 'dark' : 'light');
    // 通知其他元件主題已經改變
    window.dispatchEvent(new CustomEvent('theme-changed'));
    document
      .querySelectorAll<HTMLElement>('[data-theme-toggle]')
      .forEach((b) => syncToggle(b, next));
  });

  syncAll();
  document.addEventListener('astro:page-load', syncAll);
</script>
