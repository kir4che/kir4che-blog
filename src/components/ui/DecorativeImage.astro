---
import { cn } from '@/utils/cn';

interface DecorativeImageProps {
  src: string;
  class?: string;
}

const { src, class: className } = Astro.props as DecorativeImageProps;
---

<img
  src={src}
  width={200}
  height={200}
  alt=""
  aria-hidden="true"
  loading="lazy"
  class={cn('pointer-events-none select-none', className)}
/>
