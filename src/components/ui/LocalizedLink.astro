---
import type { HTMLAttributes } from 'astro/types';

import { getLocaleFromUrl } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
}

const { href, ...rest } = Astro.props as Props;
const resolvedHref = href.startsWith('#')
  ? href
  : withLocalePrefix(href, getLocaleFromUrl(Astro.url));
---

<a href={resolvedHref} {...rest}>
  <slot />
</a>
