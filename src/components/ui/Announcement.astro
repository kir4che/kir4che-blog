---
import { Heart } from '@lucide/astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div
  role="alert"
  class="alert gap-x-2 rounded-full border border-pink-200 bg-linear-to-r from-pink-50 to-rose-100 text-sm leading-relaxed text-pink-800 dark:border-pink-700 dark:from-pink-600 dark:to-pink-700 dark:text-pink-50"
>
  <Heart size={20} fill="currentColor" opacity={0.85} />
  <p>{text}</p>
</div>
