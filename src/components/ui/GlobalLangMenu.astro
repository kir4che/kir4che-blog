---
import { ChevronDown, Languages } from '@lucide/astro';

import { SUPPORTED_LANGUAGES } from '@/config';
import { createTranslator, getLocaleFromUrl } from '@/lib/i18n';
import { getLanguageBasePath, swapLocaleInPath } from '@/lib/paths';
import type { Language } from '@/types';
import { cn } from '@/utils/cn';

interface Props {
  id?: string;
  class?: string;
  direction?: 'top' | 'bottom';
}

const { id, class: className, direction = 'bottom' } = Astro.props;

const directionClass = {
  top: 'dropdown-top',
  bottom: 'dropdown-bottom',
}[direction];

const marginClass =
  direction === 'top'
    ? "mb-2 before:absolute before:inset-x-0 before:-bottom-2 before:h-2 before:content-['']"
    : "mt-2 before:absolute before:inset-x-0 before:-top-2 before:h-2 before:content-['']";

const lang = getLocaleFromUrl(Astro.url);
const t = createTranslator(lang, 'settings');

const buildPostHref = (l: Language) => {
  const path = swapLocaleInPath(Astro.url.pathname, l);
  return `${encodeURI(path)}${Astro.url.search}`;
};

const langBasePaths = Object.fromEntries(
  SUPPORTED_LANGUAGES.map((l) => [l, getLanguageBasePath(l)])
);
---

<div id={id} class={cn('dropdown dropdown-hover', directionClass, className)} data-lang-menu>
  <button
    type="button"
    class="flex items-center gap-x-1.5 text-sm hover:bg-inherit"
    aria-expanded="false"
    data-lang-menu-toggle
  >
    <Languages size={16} aria-hidden="true" />
    <span>{t(`language.${lang}`)}</span>
    <ChevronDown size={16} aria-hidden="true" />
  </button>
  <ul
    role="menu"
    class={cn(
      'dropdown-content menu bg-surface-secondary w-24 rounded pt-1.5 shadow-md md:w-32',
      marginClass
    )}
    data-lang-menu-list
  >
    {
      SUPPORTED_LANGUAGES.map((l) => (
        <li role="none">
          <a
            href={buildPostHref(l)}
            role="menuitemradio"
            aria-checked={l === lang}
            data-lang-menu-item
            class:list={[
              'p-2 text-sm hover:bg-pink-100/80 md:px-3 dark:hover:bg-pink-900/20',
              {
                'font-semibold text-pink-700 dark:text-pink-200': l === lang,
              },
            ]}
          >
            {t(`language.${l}`)}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script is:inline define:vars={{ langBasePaths }}>
  document.querySelector('[data-lang-menu]')?.addEventListener('click', async (e) => {
    const anchor = e.target.closest('[data-lang-menu-item]');
    if (!anchor) return;

    e.preventDefault();
    const href = anchor.getAttribute('href');
    if (!href) return;

    try {
      const res = await fetch(href, { method: 'HEAD' });
      if (res.ok) {
        location.href = href;
      } else {
        const lang = Object.entries(langBasePaths).find(([, base]) => href.startsWith(base))?.[0];
        location.href = lang ? langBasePaths[lang] : href;
      }
    } catch {
      location.href = href;
    }
  });
</script>
