---
import { ChevronDown, Languages } from '@lucide/astro';

import { SUPPORTED_LANGUAGES } from '@/config';
import { createTranslator, getLocaleFromUrl } from '@/lib/i18n';
import {
  getLocalizedPostPath,
  stripLocalePrefix,
  swapLocaleInPath,
  withLocalePrefix,
} from '@/lib/paths';
import { getPostAvailableLangs, getPostMetaBySlug } from '@/lib/posts';
import type { Language } from '@/types';
import { cn } from '@/utils/cn';

interface Props {
  id?: string;
  class?: string;
  direction?: 'top' | 'bottom';
}

const { id, class: className, direction = 'bottom' } = Astro.props;

const directionClass = {
  top: 'dropdown-top',
  bottom: 'dropdown-bottom',
}[direction];

const marginClass =
  direction === 'top'
    ? "mb-2 before:absolute before:inset-x-0 before:-bottom-2 before:h-2 before:content-['']"
    : "mt-2 before:absolute before:inset-x-0 before:-top-2 before:h-2 before:content-['']";

const lang = getLocaleFromUrl(Astro.url);
const t = createTranslator(lang, 'settings');

const strippedPath = stripLocalePrefix(Astro.url.pathname);
const slugCandidate = strippedPath === '/' ? null : strippedPath.replace(/^\/+|\/+$/g, '');
const currentPostMeta = slugCandidate ? await getPostMetaBySlug(lang, slugCandidate) : null;
const availablePostLangs = currentPostMeta ? await getPostAvailableLangs(currentPostMeta.slug) : [];

const buildPostHref = (l: Language) => {
  if (currentPostMeta) {
    if (availablePostLangs.includes(l)) return getLocalizedPostPath(l, currentPostMeta.slug);

    return withLocalePrefix('/', l);
  }

  const path = swapLocaleInPath(Astro.url.pathname, l);
  return `${encodeURI(path)}${Astro.url.search}`;
};
---

<div id={id} class={cn('dropdown relative group', directionClass, className)} data-lang-menu>
  <button
    type="button"
    class="flex items-center gap-x-1.5 text-sm hover:bg-inherit"
    aria-expanded="false"
    data-lang-menu-toggle
  >
    <Languages size={16} aria-hidden="true" />
    <span>{t(`language.${lang}`)}</span>
    <ChevronDown size={16} aria-hidden="true" class="pointer-events-none select-none" />
  </button>
  <ul
    role="menu"
    class={cn(
      'dropdown-content menu bg-surface-secondary z-50 w-24 rounded shadow-md md:w-32 hidden group-focus-within:block',
      marginClass
    )}
    data-lang-menu-list
  >
    {
      SUPPORTED_LANGUAGES.map((l) => (
        <li role="none">
          <a
            href={buildPostHref(l)}
            role="menuitemradio"
            aria-checked={l === lang}
            data-lang-menu-item
            class:list={[
              'p-2 text-sm hover:bg-pink-100/80 md:px-3 dark:hover:bg-pink-900/20',
              {
                'font-semibold text-pink-700 dark:text-pink-200': l === lang,
              },
            ]}
          >
            {t(`language.${l}`)}
          </a>
        </li>
      ))
    }
  </ul>
</div>
