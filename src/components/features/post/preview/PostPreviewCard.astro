---
import PostMetaInfo from '@/components/features/post/PostMetaInfo.astro';
import LockOverlay from '@/components/features/post/preview/LockOverlay.astro';
import CategoryBadge from '@/components/ui/CategoryBadge.astro';
import type { Language, PostMeta } from '@/types';
import { getLocalizedPostPath } from '@/lib/paths';
import { cn } from '@/utils/cn';

interface Props {
  post: PostMeta;
  lang: Language;
  priority?: boolean;
  hideImage?: boolean;
  class?: string;
}

const { post, lang, priority = false, hideImage = false, class: className } = Astro.props;
const href = getLocalizedPostPath({ lang, slug: post.slug });
const showCover = Boolean(post.coverImage) && !hideImage;
---

<article
  class={cn(
    'relative rounded-2xl transition-all duration-300 hover:-translate-y-1 overflow-hidden h-full block',
    'shadow-[1px_2px_8px_rgba(247,126,157,0.18)] hover:shadow-[1px_4px_12px_rgba(233,92,133,0.28)] dark:shadow-[0_0_12px_rgba(255,214,224,0.12)] dark:hover:shadow-[0_0_20px_rgba(254,196,209,0.25)]',
    !showCover && 'bg-surface-secondary',
    className
  )}
>
  <div class="group relative flex h-full">
    <LockOverlay isLocked={Boolean(post.protected)} />
    <div
      class:list={[
        'group relative flex w-full flex-col overflow-hidden rounded-2xl',
        {
          'min-h-52': showCover,
          'min-h-40 bg-white dark:bg-gray-800': !showCover,
        },
      ]}
    >
      {
        showCover && (
          <img
            src={post.coverImage}
            alt={post.title}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding={priority ? 'sync' : 'async'}
            width="1200"
            height="630"
            sizes="(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1279px) 45vw, 560px"
            onerror="this.onerror=null;this.src='/images/cover-fallback_lg.webp';"
            draggable="false"
            class="absolute inset-0 z-0 h-full w-full object-cover brightness-[0.85] transition-all duration-500 select-none group-hover:scale-110 group-hover:brightness-105"
            transition:name={`post-cover-${post.slug}`}
          />
        )
      }
      <div
        class:list={[
          'flex h-full flex-col p-4',
          {
            'absolute inset-0 z-20': showCover,
          },
        ]}
      >
        <div>
          <h2
            transition:name={`post-title-${post.slug}`}
            class:list={[
              'mb-2 line-clamp-2 text-xl',
              {
                'text-white drop-shadow-md': showCover,
                'dark:text-foreground-primary text-gray-900 group-hover:text-pink-700 dark:group-hover:text-pink-400':
                  !showCover,
              },
            ]}
          >
            <a
              href={href}
              class:list={[
                'rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink-700 dark:focus-visible:outline-pink-300',
                {
                  'text-white': showCover,
                },
              ]}
            >
              {post.title}
            </a>
          </h2>
          {
            post.description && (
              <p
                class:list={[
                  'mb-4 line-clamp-3 text-sm/6',
                  {
                    'text-gray-100 drop-shadow': showCover,
                    'text-gray-500 dark:text-gray-400': !showCover,
                  },
                ]}
              >
                {post.description}
              </p>
            )
          }
        </div>
        <div class="mt-auto flex flex-wrap items-end gap-2">
          <CategoryBadge
            lang={lang}
            categories={post.categories ?? []}
            useDarkColor={showCover}
            class:list={[
              'relative z-40',
              {
                'rounded-full bg-black/35 px-2.5 py-0.5 backdrop-blur': showCover,
              },
            ]}
          />
          <PostMetaInfo
            lang={lang}
            date={post.date}
            wordCount={post.wordCount}
            class:list={[
              'ml-auto',
              {
                'text-gray-200': showCover,
              },
            ]}
          />
        </div>
      </div>
      {
        showCover && (
          <div
            class="absolute inset-0 z-10"
            style={{ background: 'linear-gradient(to top, rgba(0,0,0,0.35), rgba(0,0,0,0.5))' }}
          />
        )
      }
    </div>
  </div>
</article>
