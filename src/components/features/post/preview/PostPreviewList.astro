---
import PostMetaInfo from '@/components/features/post/PostMetaInfo.astro';
import LockOverlay from '@/components/features/post/preview/LockOverlay.astro';
import CategoryBadge from '@/components/ui/CategoryBadge.astro';
import { getLocalizedPostPath } from '@/lib/paths';
import type { Language, PostMeta } from '@/types';
import { cn } from '@/utils/cn';

const {
  post,
  lang,
  class: className,
} = Astro.props as {
  post: PostMeta;
  lang: Language;
  class?: string;
};

const href = getLocalizedPostPath({ lang, slug: post.slug });
---

<a
  href={href}
  class={cn(
    'group overflow-hidden bg-surface-secondary h-full block rounded-lg transition-all duration-300 hover:-translate-y-0.5',
    'shadow-[1px_2px_4px_rgba(247,126,157,0.15)] hover:shadow-[1px_3px_5px_rgba(233,92,133,0.30)] dark:shadow-[0_0_12px_rgba(255,214,224,0.15)] dark:hover:shadow-[0_0_18px_rgba(254,196,209,0.30)]',
    className
  )}
  aria-label={`Read post: ${post.title}`}
>
  <article class="relative flex flex-col p-4">
    <LockOverlay isLocked={Boolean(post.protected)} />
    <h2 class="mb-2 line-clamp-2 text-xl group-hover:text-pink-700 dark:group-hover:text-pink-400">
      {post.title}
    </h2>
    {
      post.description && (
        <p class="mb-4 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">{post.description}</p>
      )
    }
    <div class="flex flex-wrap items-center gap-2">
      <CategoryBadge lang={lang} categories={post.categories ?? []} />
      <PostMetaInfo lang={lang} date={post.date} wordCount={post.wordCount} class="ml-auto" />
    </div>
  </article>
</a>
