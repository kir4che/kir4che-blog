---
import { Languages } from '@lucide/astro';

import { getLocalizedPostPath } from '@/lib/paths';
import type { Language, Translator } from '@/types';

interface Props {
  curLang: Language;
  currSlug: string;
  langs: Language[];
  t: Translator;
}

const { curLang, currSlug, langs, t } = Astro.props;
---

<nav
  class="group relative z-10 text-xs"
  aria-label={t('language.title')}
  data-lang-menu
  data-lang-menu-hover
>
  <button
    type="button"
    class="text-primary flex items-center gap-x-0.5 font-medium"
    aria-expanded="false"
    aria-controls="post-lang-menu"
    data-lang-menu-toggle
  >
    <Languages size={14} aria-hidden="true" />
    {t(`language.short.${curLang}`)}
  </button>
  <ul
    id="post-lang-menu"
    role="menu"
    class="bg-surface-secondary absolute left-0 z-50 mt-2 hidden min-w-24 overflow-hidden rounded shadow-md group-focus-within:block group-hover:block dark:bg-gray-700"
    data-lang-menu-list
  >
    {
      langs.map((l) => (
        <li role="none">
          <a
            href={getLocalizedPostPath(l, currSlug)}
            role="menuitem"
            data-lang-menu-item
            class="text-foreground-primary block w-full px-3 py-2 hover:bg-pink-100/80 hover:text-pink-700 dark:hover:bg-pink-900/10 dark:hover:text-pink-200"
          >
            {t(`language.short.${l}`)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
