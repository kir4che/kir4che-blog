---
import { ChevronRight } from '@lucide/astro';
import type { Language } from '@/types';
import { createTranslator } from '@/lib/i18n';
import { cn } from '@/utils/cn';

interface TOCHeading {
  id: string;
  text: string;
  level: number;
}

interface TOCProps {
  lang: Language;
  headings: TOCHeading[];
}

const { lang, headings = [] } = Astro.props as TOCProps;

if (headings.length === 0) return;

const t = createTranslator(lang, 'PostPage.toc');
const tocTitle = t('title');
const expandLabel = t('expand');
const collapseLabel = t('collapse');
---

<div data-toc-root>
  <div
    class="bg-surface-secondary fixed top-20 right-0 z-50 max-h-[80vh] min-h-32 w-72 translate-x-full transform rounded-bl-md shadow-md transition-transform duration-300"
    data-toc-panel
  >
    <button
      type="button"
      class="group absolute top-0 -left-8 z-10"
      data-toc-toggle
      data-label-expand={expandLabel}
      data-label-collapse={collapseLabel}
      aria-label={expandLabel}
      aria-expanded="false"
    >
      <div
        class="flex-center bg-surface-secondary h-32 w-8 rounded-l-xl py-3 text-pink-600 shadow-[-10px_0_16px_-10px_rgba(0,0,0,0.15)] transition-all duration-300 dark:text-pink-400"
        data-toc-button
      >
        <span
          class="text-sm font-bold tracking-widest [writing-mode:vertical-rl]"
          data-toc-icon-open>{tocTitle}</span
        >
        <ChevronRight data-toc-icon-close size={24} class="hidden" />
      </div>
    </button>
    <nav class="flex h-full flex-col overflow-hidden" role="navigation" aria-label={tocTitle}>
      <div class="px-4 pt-4 pb-3">
        <h2 class="text-base font-bold text-pink-700 dark:text-pink-300">{tocTitle}</h2>
      </div>
      <ul class="flex-1 space-y-2.5 overflow-y-scroll px-4 pb-4">
        {
          headings.map((h) => (
            <li
              class:list={[
                'mb-2 text-gray-700 dark:text-gray-300',
                {
                  'font-semibold': h.level === 2,
                  'text-[13px]/6 font-medium': h.level === 3,
                  'text-xs': h.level >= 4,
                },
              ]}
              style={`margin-left: ${(h.level - 2) * 12}px`}
            >
              <a
                href={`#${h.id}`}
                data-toc-link
                class="block transition-colors hover:text-pink-600 hover:dark:text-pink-400"
              >
                {h.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-toc-root]');
    if (!root || root.dataset.init) return;

    root.dataset.init = 'true';

    const toggle = root.querySelector('[data-toc-toggle]');
    const panel = root.querySelector('[data-toc-panel]');
    const buttonInner = root.querySelector('[data-toc-button]');
    const iconOpen = root.querySelector('[data-toc-icon-open]');
    const iconClose = root.querySelector('[data-toc-icon-close]');
    const links = Array.from(root.querySelectorAll('[data-toc-link]'));
    if (!toggle || !panel || links.length === 0) return;

    const HEADER_OFFSET = 96;

    let isOpen = false;

    const headings = links
      .map((link) => {
        const href = link.getAttribute('href');
        if (!href) return null;
        const target = document.querySelector(href);
        if (!(target instanceof HTMLElement)) return null;

        return { href, target };
      })
      .filter(Boolean);

    const headingByHref = new Map(headings.map((item) => [item.href, item.target]));

    const setOpen = (open) => {
      if (open === isOpen) return;
      isOpen = open;

      panel.classList.toggle('translate-x-full', !open);
      panel.classList.toggle('translate-x-0', open);

      if (buttonInner) {
        buttonInner.classList.toggle('h-32', !open);
        buttonInner.classList.toggle('h-24', open);
      }

      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);

      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? toggle.dataset.labelCollapse : toggle.dataset.labelExpand
      );
    };

    const onClick = (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      if (target.closest('[data-toc-toggle]')) {
        setOpen(!isOpen);
        return;
      }

      const link = target.closest('[data-toc-link]');

      if (link instanceof HTMLAnchorElement) {
        const href = link.getAttribute('href');
        if (!href) return;

        const heading = headingByHref.get(href);
        if (!heading) return;

        e.preventDefault();

        const y = heading.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;

        window.scrollTo({ top: y, behavior: 'smooth' });

        setOpen(false);

        return;
      }

      if (!panel.contains(target)) setOpen(false);
    };

    // 根據目前 scroll 位置設定哪個 heading 是 active
    const setActive = () => {
      const scrollY = window.scrollY + HEADER_OFFSET + 20;

      let currId = null;
      for (let i = headings.length - 1; i >= 0; i--) {
        if (headings[i].target.offsetTop <= scrollY) {
          currId = headings[i].target.id;
          break;
        }
      }

      links.forEach((a) => {
        const isActive = currId && a.getAttribute('href') === `#${currId}`;

        a.classList.toggle('text-pink-600', isActive);
        a.classList.toggle('dark:text-pink-400', isActive);
        a.classList.toggle('font-semibold', isActive);
      });
    };

    // 集中取消事件
    const controller = new AbortController();
    const { signal } = controller;

    document.addEventListener('click', onClick, { signal });
    window.addEventListener('scroll', setActive, {
      passive: true,
      signal,
    });

    // SPA / Astro View Transition 時，頁面離開就取消事件監聽。
    window.addEventListener('pagehide', () => controller.abort(), { once: true });

    setActive();
  })();
</script>
