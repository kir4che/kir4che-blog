---
import { CalendarDays } from '@lucide/astro';

import { createTranslator } from '@/lib/i18n';
import { getLocalizedPostPath } from '@/lib/paths';
import { getPostsMeta } from '@/lib/posts';
import type { Language, PostMeta } from '@/types';
import { formatDateYmd } from '@/utils/date';

interface Props {
  lang: Language;
  currSlug: string;
  categories: string[];
}

const { lang, currSlug, categories } = Astro.props;

const t = createTranslator(lang, 'PostPage');

const categorySet = new Set(categories.map((c) => c?.trim()).filter(Boolean));
const posts = categorySet.size > 0 ? await getPostsMeta(lang) : [];

const relatedPosts: PostMeta[] = posts
  .filter(
    (post) => post.slug !== currSlug && post.categories?.some((c) => categorySet.has(c?.trim()))
  )
  .slice(0, 3);
---

{
  relatedPosts.length > 0 && (
    <section class="relative space-y-4 py-6" aria-labelledby={`related-posts-${currSlug}`}>
      <div class="flex-between mb-4 gap-2">
        <h2 class="text-base font-semibold text-pink-700 dark:text-pink-200">
          {t('relatedPosts')}
        </h2>
        <span
          class="h-px flex-1 bg-linear-to-r from-pink-200 to-transparent dark:from-pink-200/30"
          aria-hidden="true"
        />
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {relatedPosts.map((post) => {
          const date = formatDateYmd(post.date);
          if (!date) return null;

          return (
            <a
              href={getLocalizedPostPath(lang, post.slug)}
              class="group md:bg-surface-secondary md:dark:bg-surface-secondary/50 block w-full border-b border-gray-100 transition-all duration-300 last:border-b-0 md:rounded-md md:border-0 md:p-4 md:py-3 md:hover:-translate-y-1 md:hover:shadow-sm dark:border-gray-800/60"
            >
              <div class="hidden md:mb-3 md:block md:aspect-video md:w-full md:overflow-hidden md:rounded-md">
                <img
                  src={post.coverImage ?? '/images/cover-fallback_lg.webp'}
                  alt={post.title}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="420"
                  sizes="280px"
                  draggable="false"
                  class="size-full object-cover transition-transform duration-300 select-none group-hover:scale-105"
                />
              </div>
              <h3 class="text-foreground-primary mb-1 line-clamp-2 text-sm/5 font-semibold transition-colors group-hover:text-pink-700 md:text-base/5 dark:group-hover:text-pink-400">
                {post.title}
              </h3>
              <p class="mb-2 hidden text-[13px]/4.5 text-gray-600 md:line-clamp-3 dark:text-gray-400">
                {post.description}
              </p>
              {date && (
                <div class="flex items-center gap-1 text-[11px] text-gray-400 md:text-xs md:text-gray-500 dark:text-gray-500 md:dark:text-gray-300">
                  <CalendarDays size={13} aria-hidden="true" />
                  <time datetime={date.datetime} class="tracking-wide">
                    {date.display}
                  </time>
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )
}
