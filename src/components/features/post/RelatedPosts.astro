---
import { CalendarDays } from '@lucide/astro';

import { createTranslator, resolveLanguage } from '@/lib/i18n';
import { getLocalizedPostPath } from '@/lib/paths';
import { getPostsMeta } from '@/lib/posts';
import type { Language, PostMeta } from '@/types';
import { createDateFormatter } from '@/utils/date';

interface Props {
  lang: Language;
  currSlug: string;
  categories: string[];
  tags?: string[];
}

const { lang, currSlug, categories, tags = [] } = Astro.props;

const t = createTranslator(lang, 'PostPage');
const locale = resolveLanguage(lang);
const formatDate = createDateFormatter(locale, 'short');

const categorySet = new Set(categories.map((c) => c?.trim()).filter(Boolean));
const tagSet = new Set(tags.map((t) => t?.trim()).filter(Boolean));
const posts = categorySet.size > 0 || tagSet.size > 0 ? await getPostsMeta(lang) : [];

const relatedPosts: PostMeta[] = posts
  .map((post) => {
    if (post.slug === currSlug) return { post, score: -1 };
    const sharedCategories = post.categories?.filter((c) => categorySet.has(c?.trim())).length ?? 0;
    const sharedTags = post.tags?.filter((t) => tagSet.has(t?.trim())).length ?? 0;
    return { post, score: sharedCategories * 2 + sharedTags };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || +new Date(b.post.date) - +new Date(a.post.date))
  .map(({ post }) => post)
  .slice(0, 3);
---

{
  relatedPosts.length > 0 && (
    <section class="relative space-y-4 py-6" aria-labelledby={`related-posts-${currSlug}`}>
      <div class="flex-between mb-4 gap-2">
        <h2 class="text-base font-semibold text-pink-700 dark:text-pink-200">
          {t('relatedPosts')}
        </h2>
        <span
          class="h-px flex-1 bg-linear-to-r from-pink-200 to-transparent dark:from-pink-200/30"
          aria-hidden="true"
        />
      </div>
      <div class="scrollbar-none flex w-full snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
        {relatedPosts.map((post) => {
          const date = formatDate(post.date);
          if (!date) return null;

          return (
            <div class="bg-surface-secondary dark:bg-surface-secondary/50 w-55 shrink-0 snap-start rounded-md p-4 sm:w-62.5 md:w-70">
              <div class="mb-3 aspect-video">
                <img
                  src={post.coverImage ?? `/og/${lang}/${post.slug}.png`}
                  alt={post.title}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="420"
                  sizes="280px"
                  draggable="false"
                  onerror="this.onerror=null;this.src='/images/cover-fallback_lg.webp';"
                  class="size-full object-cover transition-transform duration-300 select-none"
                />
              </div>
              <a href={getLocalizedPostPath({ lang, slug: post.slug })} class="mb-1 block">
                <h3 class="line-clamp-2 text-base/5 font-semibold hover:text-pink-700 dark:hover:text-pink-400">
                  {post.title}
                </h3>
              </a>
              <p class="mb-2 line-clamp-3 text-[13px]/4.5 text-gray-600 dark:text-gray-400">
                {post.description}
              </p>
              {date && (
                <div class="flex items-center gap-1 text-xs text-gray-500 dark:text-gray-300">
                  <CalendarDays size={13} aria-hidden="true" />
                  <time datetime={date.datetime} class="tracking-wide">
                    {date.display}
                  </time>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )
}
