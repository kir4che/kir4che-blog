---
import { LockKeyhole } from '@lucide/astro';

import type { Language } from '@/types';
import { createTranslator } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import LoadingSpinner from '@/components/ui/LoadingSpinner.astro';

interface PostPasswordGateProps {
  slug: string;
  lang: Language;
}

const { slug, lang } = Astro.props as PostPasswordGateProps;

const t = createTranslator(lang, 'PostPage');
const tCommon = createTranslator(lang, 'common');

const backHref = withLocalePrefix('/archives', lang);
---

<section
  class="flex-center min-h-[70vh]"
  data-password-gate
  data-slug={slug}
  data-lang={lang}
  data-text-incorrect={t('incorrectPassword')}
  data-text-too-many={t('tooManyAttempts')}
  data-text-verify={tCommon('button.verifying')}
  data-text-submit={tCommon('button.submit')}
  data-text-enter={t('enterPassword')}
  data-text-error={t('passwordGate.error')}
>
  <div data-gate-content class="flex-center flex-col gap-4">
    <LockKeyhole size={48} class="stroke-1.5 text-pink-700 dark:text-pink-500" />
    <h2>{t('passwordGate.title')}</h2>
    <form data-form class="flex w-full shadow">
      <input
        type="password"
        data-password-input
        placeholder={t('enterPassword')}
        autocomplete="current-password"
        class="input bg-surface-secondary flex-1 outline-none"
      />
      <button
        type="submit"
        data-submit
        class="btn border-pink-600 bg-pink-600 text-white hover:bg-pink-700 sm:w-auto dark:border-pink-800 dark:bg-pink-800 dark:hover:bg-pink-900"
      >
        <span data-submit-label>{tCommon('button.submit')}</span>
      </button>
    </form>
    <div data-locked class="hidden text-center">
      <p data-locked-text class="text-foreground-primary/80 text-sm"></p>
      <a
        href={backHref}
        class="btn mt-4 border-none bg-pink-600 text-white hover:bg-pink-700 dark:bg-pink-800 dark:hover:bg-pink-900"
      >
        {t('backToPosts')}
      </a>
    </div>
  </div>
  <LoadingSpinner
    data-post-loading
    class="mx-auto hidden"
    aria-label={tCommon('button.verifying')}
  />
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-password-gate]');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.init === 'true') return;
    root.dataset.init = 'true';

    const slug = root.dataset.slug;
    if (!slug) return;

    const lang = root.dataset.lang;

    const textIncorrect = root.dataset.textIncorrect;
    const textTooMany = root.dataset.textTooMany;
    const textVerify = root.dataset.textVerify;
    const textSubmit = root.dataset.textSubmit;
    const textEnter = root.dataset.textEnter;
    const textError = root.dataset.textError;

    const form = root.querySelector('[data-form]');
    const input = root.querySelector('[data-password-input]');
    const submitBtn = root.querySelector('[data-submit]');
    const submitLabel = root.querySelector('[data-submit-label]');
    const lockedBlock = root.querySelector('[data-locked]');
    const lockedText = root.querySelector('[data-locked-text]');
    const gateContent = root.querySelector('[data-gate-content]');
    const postLoading = root.querySelector('[data-post-loading]');

    if (
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLInputElement) ||
      !(submitBtn instanceof HTMLButtonElement)
    )
      return;

    const SECURITY_LIMITS = {
      maxAttempts: 3,
      lockDurationMs: 60_000,
    };

    const lockKey = `postPasswordLockUntil:${slug}`; // 鎖定時間
    const attemptsKey = `postPasswordAttempts:${slug}`; // 嘗試次數

    let isLocked = false; // 是否鎖定
    let isLoading = false; // 是否加載中
    let lockUntil = null; // 鎖定結束時間
    let lockTimer = null; // 倒數計時器
    let isNavigating = false; // 是否正在跳轉頁面

    // 發送 Toast 通知
    const dispatchToast = (message) => {
      window.dispatchEvent(
        new CustomEvent('toast', {
          detail: { message, variant: 'error' },
        })
      );
    };

    // 顯示 / 隱藏文章 Loading
    const setPostLoading = (loading) => {
      if (!postLoading) return;
      postLoading.classList.toggle('hidden', !loading);
      postLoading.setAttribute('aria-hidden', loading ? 'false' : 'true');
    };

    // 設定加載狀態
    const setLoadingState = (loading) => {
      isLoading = loading;
      input.disabled = loading || isLocked;
      submitBtn.disabled = loading || isLocked;

      if (submitLabel) submitLabel.textContent = loading ? textVerify : textSubmit;

      gateContent?.classList.toggle('hidden', loading);
      setPostLoading(loading);
    };

    // 更新鎖定提示文字
    const updateLockedText = () => {
      if (!lockedText) return;

      if (!lockUntil) {
        lockedText.textContent = textTooMany;
        return;
      }

      const remaining = Math.ceil((lockUntil - Date.now()) / 1000); // 剩餘秒數
      lockedText.textContent = textTooMany.includes('{seconds}')
        ? textTooMany.replace(/\{seconds\}/g, String(Math.max(0, remaining)))
        : textTooMany;
    };

    // 設定鎖定狀態
    const setLockedState = (locked) => {
      isLocked = locked;
      lockedBlock?.classList.toggle('hidden', !locked);
      form.classList.toggle('hidden', locked);
      input.disabled = locked || isLoading;
      submitBtn.disabled = locked || isLoading;
      if (locked) updateLockedText();
    };

    // 檢查是否已鎖定
    const checkLock = () => {
      try {
        const stored = Number(localStorage.getItem(lockKey));
        if (Number.isFinite(stored) && Date.now() < stored) {
          lockUntil = stored;
          setLockedState(true);
        } else {
          localStorage.removeItem(lockKey);
          localStorage.removeItem(attemptsKey);
        }
      } catch {}
    };

    // 開始鎖定倒數
    const startLockCountdown = () => {
      if (!lockUntil || lockTimer) return;

      updateLockedText();
      lockTimer = window.setInterval(() => {
        if (Date.now() >= lockUntil) {
          lockUntil = null;
          setLockedState(false); // 解鎖
          localStorage.removeItem(lockKey);
          localStorage.removeItem(attemptsKey);
          clearInterval(lockTimer);
          lockTimer = null;
          return;
        }
        updateLockedText(); // 每秒更新倒數
      }, 1000);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isLocked || isLoading) return;

      const password = input.value.trim();
      input.value = '';
      if (!password) return;

      setLoadingState(true);

      // 發送驗證請求
      try {
        const res = await fetch('/api/verify-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, password, lang }),
        });

        const isJson = res.headers.get('content-type')?.includes('application/json');
        const data = isJson ? await res.json() : null;

        if (res.ok) {
          isNavigating = true;
          setPostLoading(true);
          window.location.reload();
          return;
        }

        if (res.status === 429) {
          const lockMs =
            typeof data?.lockSeconds === 'number'
              ? data.lockSeconds * 1000
              : SECURITY_LIMITS.lockDurationMs;

          lockUntil = Date.now() + lockMs;
          localStorage.setItem(lockKey, String(lockUntil));
          localStorage.removeItem(attemptsKey);
          setLockedState(true);
          startLockCountdown();
          return;
        }

        const attempts = Number(localStorage.getItem(attemptsKey) ?? 0) + 1; // 累加嘗試次數

        // 超過嘗試次數限制
        if (attempts >= SECURITY_LIMITS.maxAttempts) {
          lockUntil = Date.now() + SECURITY_LIMITS.lockDurationMs;
          localStorage.setItem(lockKey, String(lockUntil));
          localStorage.removeItem(attemptsKey);
          setLockedState(true);
          startLockCountdown();
        } else {
          localStorage.setItem(attemptsKey, String(attempts));
          dispatchToast(textIncorrect);
        }
      } catch {
        dispatchToast(textError);
      } finally {
        if (!isNavigating) setLoadingState(false);
      }
    });

    checkLock(); // 初始化時檢查是否已鎖定
    if (lockUntil) startLockCountdown();

    input.placeholder = textEnter;

    window.addEventListener('beforeunload', () => {
      if (lockTimer) clearInterval(lockTimer); // 離開頁面清理 timer
    });
  })();
</script>
