---
import { LockKeyhole } from '@lucide/astro';

import type { Language } from '@/types';
import { createTranslator } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import LoadingSpinner from '@/components/ui/LoadingSpinner.astro';

interface PostPasswordGateProps {
  slug: string;
  lang: Language;
}

const { slug, lang } = Astro.props as PostPasswordGateProps;

const t = createTranslator(lang, 'PostPage');
const tCommon = createTranslator(lang, 'common');

const backHref = withLocalePrefix('/archives', lang);
---

<section
  class="flex-center min-h-[70vh]"
  data-password-gate
  data-slug={slug}
  data-lang={lang}
  data-text-incorrect={t('incorrectPassword')}
  data-text-too-many={t('tooManyAttempts')}
  data-text-verify={tCommon('button.verifying')}
  data-text-submit={tCommon('button.submit')}
  data-text-enter={t('enterPassword')}
  data-text-error={t('passwordGate.error')}
>
  <div data-gate-content class="flex-center flex-col gap-4">
    <LockKeyhole size={48} class="stroke-1.5 text-pink-700 dark:text-pink-500" />
    <h2>{t('passwordGate.title')}</h2>
    <form data-form class="flex w-full shadow">
      <input
        type="password"
        data-password-input
        placeholder={t('enterPassword')}
        autocomplete="current-password"
        class="input bg-surface-secondary flex-1 outline-none"
      />
      <button
        type="submit"
        data-submit
        class="btn border-pink-600 bg-pink-600 text-white hover:bg-pink-700 sm:w-auto dark:border-pink-800 dark:bg-pink-800 dark:hover:bg-pink-900"
      >
        <span data-submit-label>{tCommon('button.submit')}</span>
      </button>
    </form>
    <div data-locked class="hidden text-center">
      <p data-locked-text class="text-foreground-primary/80 text-sm"></p>
      <a
        href={backHref}
        class="btn mt-4 border-none bg-pink-600 text-white hover:bg-pink-700 dark:bg-pink-800 dark:hover:bg-pink-900"
      >
        {t('backToPosts')}
      </a>
    </div>
  </div>
  <LoadingSpinner
    data-post-loading
    class="mx-auto hidden"
    aria-label={tCommon('button.verifying')}
  />
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-password-gate]');
    if (!root || root.dataset.init === 'true') return;
    root.dataset.init = 'true';

    const { slug, lang, textIncorrect, textTooMany, textVerify, textSubmit, textEnter, textError } =
      root.dataset;
    if (!slug) return;

    const form = root.querySelector('[data-form]');
    const input = root.querySelector('[data-password-input]');
    const submitBtn = root.querySelector('[data-submit]');
    const submitLabel = root.querySelector('[data-submit-label]');
    const lockedBlock = root.querySelector('[data-locked]');
    const lockedText = root.querySelector('[data-locked-text]');
    const gateContent = root.querySelector('[data-gate-content]');
    const postLoading = root.querySelector('[data-post-loading]');

    if (!form || !input || !submitBtn) return;

    const LIMITS = { maxAttempts: 3, lockMs: 60_000 };
    const lockKey = `lock:${slug}`;
    const attemptsKey = `attempts:${slug}`;

    let isLocked = false;
    let isLoading = false;
    let lockUntil = null;
    let lockTimer = null;

    const notify = (message) =>
      window.dispatchEvent(new CustomEvent('toast', { detail: { message, variant: 'error' } }));

    // 切換載入狀態
    const setLoading = (loading) => {
      isLoading = loading;
      input.disabled = submitBtn.disabled = loading || isLocked;
      if (submitLabel) submitLabel.textContent = loading ? textVerify : textSubmit;
      gateContent?.classList.toggle('hidden', loading);
      postLoading?.classList.toggle('hidden', !loading);
      if (postLoading) postLoading.setAttribute('aria-hidden', String(!loading));
    };

    // 切換錯誤次數過多的鎖定狀態
    const setLocked = (locked) => {
      isLocked = locked;
      form.classList.toggle('hidden', locked);
      lockedBlock?.classList.toggle('hidden', !locked);
      input.disabled = submitBtn.disabled = locked || isLoading;
      if (locked) updateLockText();
    };

    // 更新鎖定倒數計時文字
    const updateLockText = () => {
      if (!lockedText) return;
      const remain = lockUntil ? Math.max(0, Math.ceil((lockUntil - Date.now()) / 1000)) : 0;
      lockedText.textContent = textTooMany.replace(/\{seconds\}/g, String(remain));
    };

    // 啟動鎖定與倒數計時
    const startLock = (expireTime) => {
      lockUntil = expireTime;
      localStorage.setItem(lockKey, String(lockUntil));
      localStorage.removeItem(attemptsKey);
      setLocked(true);

      if (lockTimer) clearInterval(lockTimer);
      lockTimer = setInterval(() => {
        if (Date.now() >= lockUntil) {
          clearInterval(lockTimer);
          lockUntil = null;
          localStorage.removeItem(lockKey);
          setLocked(false);
        } else updateLockText();
      }, 1000);
    };

    // 頁面載入時檢查是否還在鎖定期間
    const checkExistingLock = () => {
      const stored = Number(localStorage.getItem(lockKey));
      if (stored && Date.now() < stored) startLock(stored);
      else {
        localStorage.removeItem(lockKey);
        localStorage.removeItem(attemptsKey);
      }
    };

    // 提交密碼表單事件
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isLocked || isLoading) return;

      const password = input.value.trim();
      if (!password) return;

      input.value = '';
      setLoading(true);

      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(slug)}/verify`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, password, lang }),
          credentials: 'include',
        });

        if (res.ok) {
          window.location.reload();
          return;
        }

        if (res.status === 429) {
          const data = await res.json().catch(() => null);
          const lockMs = (data?.lockSeconds || LIMITS.lockMs / 1000) * 1000;
          startLock(Date.now() + lockMs);
        } else {
          const attempts = Number(localStorage.getItem(attemptsKey) || 0) + 1;
          if (attempts >= LIMITS.maxAttempts) startLock(Date.now() + LIMITS.lockMs);
          else {
            localStorage.setItem(attemptsKey, String(attempts));
            notify(textIncorrect);
          }
        }
      } catch {
        notify(textError);
      }

      setLoading(false);
    });

    input.placeholder = textEnter;
    checkExistingLock();
    window.addEventListener('beforeunload', () => lockTimer && clearInterval(lockTimer));
  })();
</script>
