---
interface PostCommentsProps {
  slug: string;
  hasPassword?: boolean;
}

const { slug, hasPassword = false } = Astro.props as PostCommentsProps;
---

<div
  id="post-comments"
  class:list={['utterances', hasPassword ? 'hidden' : '']}
  data-post-comments
  data-slug={slug}
  data-locked={hasPassword ? 'true' : 'false'}
>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-post-comments]');
    if (!root || root.dataset.init) return;
    root.dataset.init = 'true';

    const resolveTheme = () =>
      document.documentElement.classList.contains('dark') ? 'github-dark' : 'github-light';

    let currentTheme = '';
    const mount = () => {
      const theme = resolveTheme();
      currentTheme = theme;

      root.replaceChildren();
      const script = document.createElement('script');
      script.src = 'https://utteranc.es/client.js';
      script.async = true;
      script.setAttribute('repo', 'kir4che/kir4che-blog');
      script.setAttribute('issue-term', root.dataset.slug || '');
      script.setAttribute('label', 'comment');
      script.setAttribute('theme', theme);
      script.crossOrigin = 'anonymous';
      root.appendChild(script);
    };

    const unlock = () => {
      if (root.dataset.locked !== 'true') return;
      root.dataset.locked = 'false';
      root.classList.remove('hidden');
      mount();
    };

    if (root.dataset.locked !== 'true') mount();

    window.addEventListener('post:unlocked', unlock);

    const observer = new MutationObserver(() => {
      if (root.dataset.locked === 'true') return;
      const nextTheme = resolveTheme();
      if (nextTheme === currentTheme) return;
      mount();
    });

    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  })();
</script>
