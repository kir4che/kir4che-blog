---
import { X } from '@lucide/astro';

import { categoryMap, tagMap } from '@/config/taxonomy';
import type { AdminPost } from '@/types';
import TaxonomyChip from './TaxonomyChip.astro';

interface Props {
  post: AdminPost | null;
  isEditing: boolean;
  defaultDate: string;
}

const { post, isEditing, defaultDate } = Astro.props;
const meta = post?.meta;

const allCategories = Object.values(categoryMap).flatMap((cat) => {
  const items = [{ slug: cat.slug, label: cat.name.tw }];
  if (cat.subcategories)
    items.push(
      ...Object.values(cat.subcategories).map((sub) => ({ slug: sub.slug, label: sub.name.tw }))
    );
  return items;
});

const allTags = Object.values(tagMap).map((tag) => ({ slug: tag.slug, label: tag.name.tw }));

const selectedCategories = meta?.categories || [];
const selectedTags = meta?.tags || [];
---

<div id="metadata-dropdown" class="relative">
  <button
    type="button"
    id="metadata-btn"
    class="btn btn-sm bg-surface-secondary text-primary border-primary text-nowrap"
    aria-controls="metadata-panel"
    aria-expanded="false"
  >
    文章設定
  </button>
  <div
    id="metadata-panel"
    class="bg-surface-secondary absolute right-0 z-50 mt-2 hidden w-80 flex-col rounded p-4 pt-2 shadow-md"
    aria-hidden="true"
  >
    <div class="flex-between gap-3">
      <fieldset class="fieldset flex-1">
        <legend class="fieldset-legend">slug</legend>
        <input
          type="text"
          name="slug"
          id="slug-input"
          value={post?.slug || ''}
          class="input input-sm w-full border"
          placeholder="留空將自動生成"
          disabled={isEditing}
        />
      </fieldset>
      {
        !isEditing && (
          <fieldset class="fieldset">
            <legend class="fieldset-legend">
              語言 <span class="text-red-500">*</span>
            </legend>
            <select
              name="lang"
              id="lang-input"
              required
              disabled={isEditing}
              class="w-fit border px-2 py-1.5"
            >
              <option value="" disabled selected={!meta?.lang}>
                請選擇語言
              </option>
              <option value="tw" selected={meta?.lang === 'tw'}>
                繁體中文
              </option>
              <option value="en" selected={meta?.lang === 'en'}>
                English
              </option>
            </select>
          </fieldset>
        )
      }
    </div>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">發布時間</legend>
      <input
        type="datetime-local"
        name="date"
        id="date-input"
        value={defaultDate}
        class="input input-sm w-full border"
      />
    </fieldset>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">封面圖片</legend>
      <div id="cover-preview-wrap" class:list={['relative mb-1.5', { hidden: !meta?.coverImage }]}>
        <img
          id="cover-preview"
          src={meta?.coverImage || ''}
          alt="封面預覽"
          class="h-24 w-full rounded object-cover"
        />
        <button
          type="button"
          id="remove-cover-btn"
          class="btn btn-xs btn-link text-surface-secondary absolute top-1 right-1"
        >
          <X size={14} aria-label="移除封面" aria-hidden="true" />
        </button>
      </div>
      <input
        type="text"
        name="coverImage"
        id="cover-url-input"
        value={meta?.coverImage || ''}
        class="input input-sm w-full border"
        placeholder="填寫圖片 URL 或留空"
      />
    </fieldset>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">文章簡介</legend>
      <textarea
        name="description"
        id="desc-input"
        placeholder="建議中文 60 - 150 字，英文 120 - 300 字之間。"
        class="textarea textarea-sm h-20 w-full border">{meta?.description || ''}</textarea
      >
    </fieldset>
    <div class="flex flex-col gap-2">
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-xs">分類</legend>
        <input
          type="text"
          name="categories"
          id="cat-input"
          value={(meta?.categories || []).join(', ')}
          class="input input-sm w-full border"
          placeholder="Tech, Life"
        />
        <div id="cat-chips" class="hidden max-h-24 flex-wrap gap-1 overflow-y-auto pt-1.5">
          {
            allCategories.map((cat) => (
              <TaxonomyChip
                slug={cat.slug}
                inputId="cat-input"
                label={cat.label}
                selected={selectedCategories.includes(cat.slug)}
              />
            ))
          }
        </div>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-xs">標籤</legend>
        <input
          type="text"
          name="tags"
          id="tags-input"
          value={(meta?.tags || []).join(', ')}
          class="input input-sm w-full border"
          placeholder="astro, react"
        />
        <div id="tags-chips" class="hidden max-h-24 flex-wrap gap-1 overflow-y-auto pt-1.5">
          {
            allTags.map((tag) => (
              <TaxonomyChip
                slug={tag.slug}
                inputId="tags-input"
                label={tag.label}
                selected={selectedTags.includes(tag.slug)}
              />
            ))
          }
        </div>
      </fieldset>
    </div>
    <div class="flex flex-col gap-3 pt-4">
      <label class="flex w-max items-center gap-2 text-sm">
        <input
          type="checkbox"
          name="featured"
          class="checkbox checkbox-xs"
          checked={meta?.featured}
        />
        熱門文章
      </label>
      <div class="flex items-center">
        <label class="flex w-max items-center gap-2 text-sm">
          <input
            type="checkbox"
            name="showUpdatedAt"
            id="show-updated-at"
            class="checkbox checkbox-xs"
            checked={meta?.showUpdatedAt}
          />
          顯示更新時間
        </label>
        <p
          id="updated-at-display"
          class:list={['text-xs text-gray-500', { hidden: !meta?.showUpdatedAt }]}
        >
          （{meta?.updatedAt ? `上次更新：${meta.updatedAt}` : '儲存後自動設定'}）
        </p>
      </div>

      <div class="flex items-center gap-2">
        <label class="flex w-max items-center gap-2 text-sm">
          <input
            type="checkbox"
            name="protected"
            id="has-password"
            class="checkbox checkbox-xs"
            checked={!!meta?.protected}
          />
          密碼保護
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  const coverUrlInput = document.getElementById('cover-url-input') as HTMLInputElement | null;
  const coverPreviewWrap = document.getElementById('cover-preview-wrap');
  const coverPreview = document.getElementById('cover-preview') as HTMLImageElement | null;
  const removeCoverBtn = document.getElementById('remove-cover-btn');
  const metadataDropdown = document.getElementById('metadata-dropdown');
  const metadataBtn = document.getElementById('metadata-btn');
  const metadataPanel = document.getElementById('metadata-panel');

  // 切換 metadata 開關
  const setMetadataPanelOpen = (open: boolean) => {
    metadataPanel?.classList.toggle('hidden', !open);
    metadataPanel?.setAttribute('aria-hidden', open ? 'false' : 'true');
    metadataBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };
  const closeMetadataPanel = () => setMetadataPanelOpen(false);
  const toggleMetadataPanel = () => {
    const isOpen = !metadataPanel?.classList.contains('hidden');
    setMetadataPanelOpen(!isOpen);
  };

  metadataBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMetadataPanel();
  });

  metadataPanel?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  document.addEventListener('click', (e) => {
    if (!metadataDropdown?.contains(e.target as Node)) closeMetadataPanel();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMetadataPanel();
  });

  // 顯示封面照片預覽
  const showPreview = (src: string) => {
    if (coverPreview) coverPreview.src = src;
    coverPreviewWrap?.classList.remove('hidden');
  };

  const hidePreview = () => coverPreviewWrap?.classList.add('hidden');

  // 封面圖片連結輸入
  coverUrlInput?.addEventListener('input', () => {
    const url = coverUrlInput.value.trim();
    if (url) {
      showPreview(url);
    } else hidePreview();
  });

  removeCoverBtn?.addEventListener('click', () => {
    if (coverUrlInput) coverUrlInput.value = '';
    hidePreview();
  });

  const showUpdatedAtToggle = document.getElementById('show-updated-at') as HTMLInputElement | null;
  const updatedAtDisplay = document.getElementById('updated-at-display');

  showUpdatedAtToggle?.addEventListener('change', () => {
    updatedAtDisplay?.classList.toggle('hidden', !showUpdatedAtToggle.checked);
  });

  const getSelectedSlugs = (input: HTMLInputElement) =>
    input.value
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);

  const updateChips = (inputId: string) => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (!input) return;
    const selected = getSelectedSlugs(input);
    document
      .querySelectorAll<HTMLElement>(`.taxonomy-chip[data-input="${inputId}"]`)
      .forEach((chip) => {
        const isSelected = selected.includes(chip.dataset.slug!);
        chip.classList.toggle('border-primary', isSelected);
        chip.classList.toggle('text-primary', isSelected);
        chip.classList.toggle('border-gray-300', !isSelected);
        chip.classList.toggle('text-gray-400', !isSelected);
      });
  };

  document.querySelectorAll<HTMLElement>('.taxonomy-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const inputId = chip.dataset.input!;
      const slug = chip.dataset.slug!;
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      if (!input) return;

      const selected = getSelectedSlugs(input);
      const idx = selected.indexOf(slug);
      if (idx >= 0) selected.splice(idx, 1);
      else selected.push(slug);

      input.value = selected.join(', ');
      updateChips(inputId);
    });
  });

  document.getElementById('cat-input')?.addEventListener('input', () => updateChips('cat-input'));
  document.getElementById('tags-input')?.addEventListener('input', () => updateChips('tags-input'));

  const setupChipsVisibility = (inputId: string, chipsId: string) => {
    const input = document.getElementById(inputId);
    const chips = document.getElementById(chipsId);
    if (!input || !chips) return;

    input.addEventListener('focus', () => chips.classList.replace('hidden', 'flex'));
    input.addEventListener('blur', () => chips.classList.replace('flex', 'hidden'));

    // 防止點擊 chip 時 input 失焦，讓 chips 保持可見
    chips.addEventListener('mousedown', (e) => e.preventDefault());
  };

  setupChipsVisibility('cat-input', 'cat-chips');
  setupChipsVisibility('tags-input', 'tags-chips');
</script>
