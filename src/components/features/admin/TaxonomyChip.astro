---
interface TaxonomyChipProps {
  slug: string;
  inputId: string;
  label: string;
  selected: boolean;
}

const { slug, inputId, label, selected } = Astro.props as TaxonomyChipProps;
---

<button
  type="button"
  data-slug={slug}
  data-input={inputId}
  class:list={[
    'taxonomy-chip cursor-pointer rounded border px-1.5 py-0.5 text-xs transition-colors',
    selected ? 'border-primary text-primary' : 'border-gray-300 text-gray-400',
  ]}
>
  {label}
</button>
