---
import { Copy, Pencil, X } from '@lucide/astro';

import type { Language, AdminPost } from '@/types';
import { createDateFormatter } from '@/utils/date';

interface Props {
  lang: Language;
  posts: AdminPost[];
}

const { lang, posts } = Astro.props;

const formatDate = createDateFormatter('zh-TW');
const toDateText = (date: string) => formatDate(date)?.display ?? '';
---

<section data-lang-section={lang}>
  {
    posts.length > 0 && (
      <div class="overflow-x-auto">
        <table class="table-zebra table w-full">
          <thead>
            <tr>
              <th>標題</th>
              <th>日期</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr
                class="hover"
                data-post-row
                data-lang={post.lang}
                data-status={post.meta.draft ? 'draft' : 'published'}
                data-search={`${post.meta.title} ${post.slug}`.toLowerCase()}
              >
                <td class:list={['min-w-80', { 'opacity-50': post.meta.draft }]}>
                  <a
                    href={`/admin/editor?id=${encodeURIComponent(post.id)}`}
                    target="_blank"
                    rel="noopener"
                    class="font-medium"
                  >
                    {post.meta.title}
                  </a>
                </td>
                <td class="whitespace-nowrap">{toDateText(post.meta.date)}</td>
                <td class="space-x-2 whitespace-nowrap">
                  <a
                    href={`/admin/editor?id=${encodeURIComponent(post.id)}`}
                    class="btn btn-xs btn-link p-0"
                    aria-label="編輯文章"
                  >
                    <Pencil size={16} aria-hidden="true" />
                  </a>
                  <form method="POST" class="inline">
                    <input type="hidden" name="action" value="duplicate" />
                    <input type="hidden" name="id" value={post.id} />
                    <button type="submit" class="btn btn-xs btn-link p-0" aria-label="複製文章">
                      <Copy size={16} aria-hidden="true" />
                    </button>
                  </form>
                  <form
                    method="POST"
                    onsubmit="return confirm('確定要刪除這篇文章嗎？');"
                    class="inline"
                  >
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={post.id} />
                    <button type="submit" class="btn btn-xs btn-link p-0" aria-label="刪除文章">
                      <X size={16} aria-hidden="true" />
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</section>
