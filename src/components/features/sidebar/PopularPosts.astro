---
import LocalizedLink from '@/components/ui/LocalizedLink.astro';
import { getLocaleFromUrl } from '@/lib/i18n';
import { getPostPath } from '@/lib/paths';
import type { Translator } from '@/types';
import { Sparkles } from '@lucide/astro';

interface PopularPost {
  slug: string;
  title: string;
}

interface Props {
  t: Translator;
  posts: PopularPost[];
}

const { t, posts } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
if (!t || posts.length === 0) return null;
---

<section>
  <h3 class="mb-3 flex items-center gap-x-1.5 text-lg text-pink-700 uppercase dark:text-pink-300">
    <Sparkles size={16} aria-hidden="true" />
    <span class="text-gradient">{t('popularPosts.title')}</span>
  </h3>
  <ul class="space-y-2">
    {
      posts.map(({ slug, title }, index) => (
        <li class="group relative">
          <LocalizedLink
            href={getPostPath(slug)}
            lang={lang}
            className="flex items-start gap-2 text-sm/5.5 text-foreground-primary hover:text-pink-700 dark:hover:text-pink-400"
          >
            <span class="mt-0.5 shrink-0 text-xs font-bold text-pink-500 select-none dark:text-pink-300">
              {index + 1}.
            </span>
            <span class="line-clamp-2">{title ?? t('popularPosts.untitledPost')}</span>
          </LocalizedLink>
        </li>
      ))
    }
  </ul>
</section>
