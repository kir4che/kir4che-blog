---
import LocalizedLink from '@/components/ui/LocalizedLink';
import { getCategoryStyle } from '@/lib/categories';
import { getLocaleFromUrl } from '@/lib/i18n';
import type { SidebarCategory, Translator } from '@/types';
import { Folder } from '@lucide/astro';

interface Props {
  t: Translator;
  categories: SidebarCategory[];
}

const { t, categories } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
if (!t || categories.length === 0) return null;

const rotations = [
  'rotate-1',
  '-rotate-1',
  'rotate-[0.5deg]',
  '-rotate-[1.2deg]',
  'rotate-[0.8deg]',
  '-rotate-[0.5deg]',
];

const MAX_VISIBLE = 15;
const filteredCategories = categories.filter((c) => c.slug !== 'uncategorized');
const visibleCategories = filteredCategories.slice(0, MAX_VISIBLE);
const hasMore = filteredCategories.length > MAX_VISIBLE;
const remainingCount = filteredCategories.length - MAX_VISIBLE;
---

<section>
  <h3 class="mb-3 flex items-center gap-x-1.5 text-lg text-pink-700 uppercase dark:text-pink-300">
    <Folder size={16} aria-hidden="true" />
    <span class="text-gradient">{t('categories')}</span>
  </h3>
  <ul class="flex flex-wrap gap-x-2 gap-y-3">
    {
      visibleCategories.map(({ slug, name, color, postCount }, index) => (
        <li
          style={getCategoryStyle(color)}
          class={`${rotations[index % rotations.length]} transition-transform duration-200 hover:rotate-0`}
        >
          <LocalizedLink
            href={`/categories/${encodeURIComponent(slug)}`}
            lang={lang}
            className="inline-flex items-center gap-x-1 rounded-sm bg-surface-secondary/70 px-2.5 py-1 text-sm font-medium shadow-sm ring-1 ring-inset ring-(--category-color)/40 text-(--category-color) hover:bg-white dark:ring-(--category-color-dark)/40 dark:text-(--category-color-dark) dark:hover:bg-gray-700/70"
          >
            <span>{name}</span>
            <span class="text-xs opacity-65">({postCount})</span>
          </LocalizedLink>
        </li>
      ))
    }
    {
      hasMore && (
        <li>
          <LocalizedLink
            href="/categories"
            lang={lang}
            className="inline-flex items-center gap-x-1 rounded-sm bg-surface-secondary/70 px-2.5 py-1 text-sm font-medium text-foreground-primary/60 shadow-sm ring-1 ring-inset ring-black/10 hover:bg-white dark:ring-white/10 dark:hover:bg-gray-700/70"
          >
            +{remainingCount} more
          </LocalizedLink>
        </li>
      )
    }
  </ul>
</section>
