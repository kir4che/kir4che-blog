---
import { Folder } from '@lucide/astro';
import type { Translator, SidebarCategory } from '@/types';
import { getCategoryStyle } from '@/lib/categories';
import LocalizedLink from '@/components/ui/LocalizedLink.astro';

interface CategoryListProps {
  t: Translator;
  categories: SidebarCategory[];
}

const { t, categories } = Astro.props as CategoryListProps;
if (!t || categories.length === 0) return null;
---

<section>
  <h3 class="text-gradient mb-3 flex items-center gap-x-2 uppercase">
    <Folder size={16} class="text-primary" aria-hidden="true" />
    {t('categories')}
  </h3>
  <ul class="flex flex-wrap items-center gap-2">
    {
      categories.map(({ slug, name, color, postCount }) => (
        <li style={getCategoryStyle(color)}>
          <LocalizedLink
            href={`/categories/${encodeURIComponent(slug)}`}
            class="text-foreground-primary transition-color flex items-center gap-x-0.5 text-sm hover:text-(--category-color) dark:hover:text-(--category-color-dark)"
          >
            <span>{name}</span>
            <span class="text-xs tracking-widest text-pink-700 dark:text-pink-200">
              ({postCount})
            </span>
          </LocalizedLink>
        </li>
      ))
    }
  </ul>
</section>
