---
import ExternalLink from '@/components/ui/ExternalLink.astro';
import type { Translator } from '@/types';
import { Link as LinkIcon } from '@lucide/astro';

interface Props {
  t: Translator;
}

const { t } = Astro.props;

const websites = [
  {
    key: 'frontendLab',
    name: t('usefulSites.items.frontendLab'),
    url: 'https://frontend-lab.kir4che.com/',
  },
  {
    key: 'kaomojiLab',
    name: t('usefulSites.items.kaomojiLab'),
    url: 'https://kaomojilab.com/',
  },
  {
    key: 'picQuads',
    name: t('usefulSites.items.picQuads'),
    url: 'https://picquads.vercel.app/',
  },
  {
    key: 'decisionwheel',
    name: t('usefulSites.items.decisionwheel'),
    url: 'https://decisionwheel.kir4che.com/',
  },
  {
    key: 'lumical',
    name: t('usefulSites.items.lumical'),
    url: 'https://lumical.kir4che.com/',
  },
];
---

<section>
  <h3 class="mb-3 flex items-center gap-x-1.5 text-lg text-pink-700 uppercase dark:text-pink-300">
    <LinkIcon size={16} aria-hidden="true" />
    <span class="text-gradient">{t('usefulSites.title')}</span>
  </h3>
  <ul class="list-disc space-y-1 pl-4">
    {
      websites.map((website) => (
        <li>
          <ExternalLink
            href={website.url}
            className="text-foreground-primary text-sm hover:text-pink-700 dark:hover:text-pink-600"
            aria-label={website.name}
          >
            {website.name}
          </ExternalLink>
        </li>
      ))
    }
  </ul>
</section>
