---
import { CONFIG } from '@/config';
import ExternalLink from '@/components/ui/ExternalLink.astro';
---

<div class="flex flex-col items-center gap-y-2">
  <p class="text-gray-800 dark:text-gray-400" aria-hidden="true">
    ───────<span class="text-pink-600 dark:text-pink-300">୨ৎ</span>───────
  </p>
  <div class="flex items-center justify-between gap-x-2.5 text-sm">
    <ExternalLink
      href="https://paypal.me/dcxxiii"
      class="text-sm text-[#5DCEFF] hover:text-[#009cde] dark:text-[#5DCEFF]"
      noline
      ariaLabel="Donate with PayPal"
    >
      <span aria-hidden="true">｡･: * </span>
      <span class="text-[#009cde] dark:text-[#5DCEFF]">PayPal</span>
      <span aria-hidden="true"> ˚:✧｡･</span>
    </ExternalLink>
    <ExternalLink
      href={`https://ko-fi.com/${CONFIG.siteInfo.name}`}
      class="text-[#FB7364] hover:text-[#F74C37] dark:text-[#FB7364]"
      noline
      ariaLabel="Support me on Ko-fi"
    >
      <span aria-hidden="true">｡･: * </span>
      <span class="text-[#F74C37] dark:text-[#FB7364]">Ko-fi</span>
      <span aria-hidden="true"> ˚:✧｡･</span>
    </ExternalLink>
  </div>
  <p class="text-gray-800 dark:text-gray-400" aria-hidden="true">
    ───────<span class="text-pink-600 dark:text-pink-300">୨ৎ</span>───────
  </p>
</div>
