---
import LocalizedLink from '@/components/ui/LocalizedLink.astro';
import { getLocaleFromUrl } from '@/lib/i18n';
import type { Translator } from '@/types';
import { Hash } from '@lucide/astro';

interface Props {
  t: Translator;
  tags: Array<{ name: string; slug: string }>;
}

const { t, tags } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
if (!t || tags.length === 0) return null;
---

<section>
  <h3 class="mb-3 flex items-center gap-x-1.5 text-lg text-pink-700 uppercase dark:text-pink-300">
    <Hash size={16} aria-hidden="true" />
    <span class="text-gradient">{t('tags')}</span>
  </h3>
  <ul class="flex flex-wrap gap-x-1.5 gap-y-2">
    {
      tags.map(({ name, slug }) => (
        <li>
          <LocalizedLink
            href={`/tags/${slug}`}
            lang={lang}
            className="group relative inline-flex items-center rounded-full border-2 border-pink-300/70 bg-surface-secondary/80 px-2.5 py-0.5 text-[13px] font-medium text-pink-700 transition-all duration-200 hover:border-pink-500 hover:bg-pink-50 dark:border-pink-700/50 dark:text-pink-300 dark:hover:border-pink-500 dark:hover:bg-pink-900/30"
          >
            # {name}
          </LocalizedLink>
        </li>
      ))
    }
  </ul>
</section>
