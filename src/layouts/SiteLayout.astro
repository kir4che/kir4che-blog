---
import { TextAlignJustify } from '@lucide/astro';

import { createTranslator, getLocaleFromUrl } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import { getSidebarData } from '@/lib/sidebar';

import ProfileCard from '@/components/features/sidebar/ProfileCard.astro';
import SearchBar from '@/components/features/sidebar/SearchBar.tsx';
import { CONFIG } from '@/config';
import Navbar from '@/components/layouts/Navbar.astro';
import RightSidebar from '@/components/layouts/RightSidebar.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import GlobalLangMenu from '@/components/ui/GlobalLangMenu.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';

const { title, description, canonical, image, noindex } = Astro.props;

const lang = getLocaleFromUrl(Astro.url);
const tSearch = createTranslator(lang, 'common.search');
const tNav = createTranslator(lang, 'nav');
const tProfile = createTranslator(lang, 'profile');
const tSidebar = createTranslator(lang, 'sidebar');
const tSettings = createTranslator(lang, 'settings');
const link = (href: string) => withLocalePrefix(href, lang);

const { categories = [], tags = [], popularPosts = [] } = await getSidebarData(lang);
const simplifiedTags = tags.map(({ name, slug }) => ({ name, slug }));
---

<BaseLayout {title} {description} {canonical} {image} {noindex}>
  <slot name="head" slot="head" />
  <StructuredData />
  <div
    id="layout-container"
    data-sidebar-open="false"
    class="group/layout mx-auto flex max-w-7xl flex-1 px-4 max-md:flex-col sm:px-6"
  >
    <div
      id="sidebar-backdrop"
      class="pointer-events-none fixed inset-0 z-50 bg-gray-900/60 opacity-0 transition-opacity duration-300 group-data-[sidebar-open=true]/layout:pointer-events-auto group-data-[sidebar-open=true]/layout:opacity-100 xl:hidden"
    >
    </div>
    <div id="main-content-wrapper" class="flex w-full min-w-0 flex-1 lg:gap-x-10 xl:gap-x-16">
      <div class="flex min-h-dvh min-w-0 flex-1 flex-col">
        <header class="mb-0 pt-4 sm:mb-2">
          <div class="mb-2 lg:hidden">
            <ProfileCard tProfile={tProfile} lang={lang} />
          </div>
          <div class="flex-between">
            <div class="flex w-full items-center gap-3 sm:gap-4">
              <Navbar t={tNav} />
              <div>
                <SearchBar
                  client:idle
                  collapsible
                  basePath={link('/')}
                  noResultsText={tSearch('noResults')}
                  placeholder={tSearch('placeholder')}
                />
              </div>
            </div>
            <div class="flex w-full items-center justify-end gap-x-3 md:gap-x-4">
              <div class="flex items-center gap-x-4">
                <GlobalLangMenu class="max-md:hidden" />
                <ThemeToggle
                  translations={{
                    light: tSettings('theme.light'),
                    dark: tSettings('theme.dark'),
                  }}
                  iconOnly
                />
              </div>
              <button
                id="right-sidebar-toggle"
                class="hover:text-primary transition-colors lg:hidden"
                aria-label="Toggle Right Sidebar"
              >
                <TextAlignJustify size={18} aria-hidden="true" />
              </button>
            </div>
          </div>
          <div id="mobile-search-portal" class="w-full"></div>
        </header>
        <main class="flex-1">
          <slot />
        </main>
        <footer class="flex-between py-6">
          <GlobalLangMenu id="global-lang-menu-footer" class="md:hidden" direction="top" />
          <p class="text-xs text-gray-400">
            © 2024 - {new Date().getFullYear()}
            {CONFIG.siteInfo.name}
            <span class="text-pink-400 dark:text-pink-500">♥</span>
          </p>
        </footer>
      </div>
      <RightSidebar
        tProfile={tProfile}
        lang={lang}
        tSidebar={tSidebar}
        categories={categories}
        tags={simplifiedTags}
        popularPosts={popularPosts}
      />
    </div>
  </div>
</BaseLayout>

<script>
  const setupSidebar = () => {
    const toggleBtn = document.getElementById('right-sidebar-toggle');
    const container = document.getElementById('layout-container');
    const backdrop = document.getElementById('sidebar-backdrop');

    if (!toggleBtn || !container || toggleBtn.dataset.initialized === 'true') return;
    toggleBtn.dataset.initialized = 'true';
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.setAttribute('aria-controls', 'right-sidebar');

    const syncBodyOverflow = (isOpen: boolean) => {
      document.body.style.overflow = isOpen && window.innerWidth < 1280 ? 'hidden' : '';
    };

    const setSidebarState = (isOpen: boolean) => {
      container.dataset.sidebarOpen = String(isOpen);
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      syncBodyOverflow(isOpen);
    };

    const closeSidebar = () => setSidebarState(false);

    const toggleMenu = () => {
      const isOpen = container.dataset.sidebarOpen === 'true';
      setSidebarState(!isOpen);
    };

    const handleResize = () => {
      if (window.innerWidth >= 1280) closeSidebar();
      else syncBodyOverflow(container.dataset.sidebarOpen === 'true');
    };

    const handleEscape = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeSidebar();
    };

    toggleBtn.addEventListener('click', toggleMenu);
    if (backdrop) backdrop.addEventListener('click', closeSidebar);
    window.addEventListener('resize', handleResize);
    document.addEventListener('keydown', handleEscape);
  };

  setupSidebar();

  document.addEventListener('astro:page-load', setupSidebar);
</script>
