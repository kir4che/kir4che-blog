---
import type { MDXContent as MDXContentType } from 'astro';
import { Image as AstroImage } from 'astro:assets';

import type { Language, PostMeta } from '@/types';
import { Copy, Share2 } from '@lucide/astro';

import PostComments from '@/components/features/post/PostComments';
import PostLangMenu from '@/components/features/post/PostLangMenu.astro';
import TripMap from '@/components/features/post/TripMap';
import PostMetaInfo from '@/components/features/post/PostMetaInfo.astro';
import PostPasswordGate from '@/components/features/post/PostPasswordGate';
import RelatedPosts from '@/components/features/post/RelatedPosts.astro';
import Toc from '@/components/features/post/Toc';
import {
  Accordion,
  Alert,
  Badge,
  Card,
  Correction,
  FigureShell,
  H1,
  H2,
  H3,
  H4,
  H5,
  H6,
  Highlight,
  Image,
  Images,
  ImagesItem,
  Kbd,
  Link,
  MDXContent,
  Rating,
  SmallText,
  Spoiler,
  Table,
  Video,
} from '@/components/mdx';
import Lightbox from '@/components/mdx/Lightbox';
import CategoryBadge from '@/components/ui/CategoryBadge.astro';
import KofiBtn from '@/components/ui/KofiBtn.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { isPostInCategory } from '@/lib/categories';
import { createTranslator } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import { normalizeTag } from '@/lib/tags';
import { createDateFormatter, parseToISODate } from '@/utils/date';

interface Props {
  lang: Language;
  post: PostMeta;
  otherLangs?: Language[];
  isProtected?: boolean;
  content?: MDXContentType;
  headings?: { depth: number; slug: string; text: string }[];
  extraComponents?: Record<string, unknown>;
}

const props = Astro.props;

if (!props.post || !props.lang) throw new Error('PostLayout 至少需要提供 "post" 與 "lang" props。');

const {
  lang,
  post,
  otherLangs = [],
  isProtected = false,
  content,
  headings = [],
  extraComponents,
} = props as Props;

const BoundLink = (props: Parameters<typeof Link>[0]) => Link({ lang, ...props });

const MDX_COMPONENTS = {
  Accordion,
  Alert,
  Badge,
  Card,
  Correction,
  FigureShell,
  h1: H1,
  h2: H2,
  h3: H3,
  h4: H4,
  h5: H5,
  h6: H6,
  a: BoundLink,
  Highlight,
  Image,
  Images,
  ImagesItem,
  Kbd,
  Link: BoundLink,
  Rating,
  SmallText,
  Spoiler,
  Table,
  Video,
};

const tSettings = createTranslator(lang, 'settings');
const tCommon = createTranslator(lang, 'common');
const tPost = createTranslator(lang, 'PostPage');

const publishedDate = post.date ? parseToISODate(post.date) : null;
const dateFormatter = createDateFormatter(lang);
const updatedAt = post.updatedAt ? dateFormatter(post.updatedAt) : null;

const tocHeadings = headings.map((h) => ({
  id: h.slug,
  text: h.text,
  level: h.depth,
}));

const isTripPost = isPostInCategory(post, { tw: '旅遊', en: 'Trip' }, 'trip');
---

<SiteLayout
  title={isProtected ? tPost('passwordGate.title') : post.title}
  description={isProtected ? tPost('passwordGate.description') : post.description}
>
  {
    post.coverImage && !isProtected && (
      <link slot="head" rel="preload" href={post.coverImage} as="image" fetchpriority="high" />
    )
  }
  {
    isProtected && (
      <PostPasswordGate
        client:load
        slug={post.slug}
        lang={lang}
        backHref={withLocalePrefix('/archives', lang)}
        texts={{
          title: tPost('passwordGate.title'),
          enterPassword: tPost('enterPassword'),
          incorrectPassword: tPost('incorrectPassword'),
          tooManyAttempts: tPost('tooManyAttempts'),
          verifying: tCommon('button.verifying'),
          submit: tCommon('button.submit'),
          error: tPost('passwordGate.error'),
          backToPosts: tPost('backToPosts'),
        }}
      />
    )
  }
  <div data-protected-content class:list={[{ hidden: isProtected }]}>
    <>
      <article class="bg-surface-secondary/80 rounded p-4 transition-all duration-300 md:p-6">
        {
          post.coverImage && (
            <AstroImage
              src={post.coverImage}
              alt={`Cover image for ${post.title}`}
              width={1200}
              height={640}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              draggable={false}
              class="mb-3 h-45 w-full object-cover object-[center_70%] select-none sm:h-56 xl:h-68"
            />
          )
        }
        <header>
          <h1 class="mb-4">{post.title}</h1>
          <div class="flex-between flex-wrap gap-x-4 gap-y-1">
            <CategoryBadge lang={lang} categories={post.categories ?? []} />
            <div class="flex items-center gap-2 sm:gap-3">
              <PostMetaInfo lang={lang} date={post.date} wordCount={post.wordCount} />
              {
                otherLangs.length > 0 && publishedDate && (
                  <PostLangMenu
                    curLang={lang}
                    currSlug={post.slug}
                    langs={otherLangs}
                    t={tSettings}
                  />
                )
              }
            </div>
          </div>
          {
            post.showUpdatedAt && updatedAt?.datetime && (
              <div class="dark:text-foreground-primary/70 flex justify-end text-xs text-gray-600">
                <time datetime={updatedAt.datetime}>
                  {tCommon('unit.updatedAt')} {updatedAt.display}
                </time>
              </div>
            )
          }
        </header>
        {
          isTripPost && (post.places?.length ?? 0) > 0 && (
            <TripMap client:visible places={post.places ?? []} />
          )
        }
        {
          content ? (
            <MDXContent
              id="post-body"
              lang={lang}
              Content={content}
              extraComponents={{ ...MDX_COMPONENTS, ...(extraComponents ?? {}) }}
            />
          ) : null
        }
        <div class="pt-8">
          <PostComments client:visible slug={post.slug} hasPassword={isProtected} />
          <hr />
          <footer>
            <div class="space-y-4">
              <p>{tPost('thanks')}</p>
              <KofiBtn label={tCommon('kofiButton')} />
            </div>
            {
              post.tags?.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-4 pb-2">
                  {post.tags.map((tag) => {
                    const normalizedTag = normalizeTag(tag, lang);
                    if (!normalizedTag) return null;

                    return (
                      <a
                        href={withLocalePrefix(`/tags/${normalizedTag.slug}`, lang)}
                        class="text-primary text-sm text-nowrap"
                        aria-label={`#${normalizedTag.name}`}
                      >
                        #{normalizedTag.name}
                      </a>
                    );
                  })}
                </div>
              )
            }
            <div
              class="flex flex-wrap items-center justify-end gap-2 text-sm text-pink-700 dark:text-pink-200"
              data-msg-copied={tPost('share.copied')}
              data-msg-copy-failed={tPost('share.copyFailed')}
            >
              <button
                type="button"
                data-share-action="copy"
                aria-label={tPost('share.copyLink')}
                class="flex items-center gap-1 rounded border border-pink-200 px-3 py-1 transition-colors hover:border-pink-400 dark:border-pink-300/40 dark:hover:border-pink-200/70"
              >
                <Copy size={16} aria-hidden="true" />
                {tPost('share.copyLink')}
              </button>
              <button
                type="button"
                data-share-action="native"
                aria-label={tPost('share.native')}
                class="flex items-center gap-1 rounded border border-pink-200 px-3 py-1 transition-colors hover:border-pink-400 dark:border-pink-300/40 dark:hover:border-pink-200/70"
              >
                <Share2 size={16} aria-hidden="true" />
                {tPost('share.native')}
              </button>
            </div>
          </footer>
        </div>
      </article>
      <RelatedPosts lang={lang} currSlug={post.slug} categories={post.categories ?? []} />
      <Toc
        client:idle
        headings={tocHeadings}
        title={tPost('toc.title')}
        expandLabel={tPost('toc.expand')}
        collapseLabel={tPost('toc.collapse')}
      />
    </>
  </div>
  <Lightbox client:idle />
</SiteLayout>

<script>
  import { LIGHTBOX_EVENT } from '@/components/mdx/Lightbox';
  import { showToast } from '@/utils/toast';

  let onVisibilityChange: (() => void) | null = null;

  // 複製網址到剪貼簿
  const copyToClipboard = async (url: string, msgCopied: string, msgCopyFailed: string) => {
    try {
      await navigator.clipboard.writeText(url);
      showToast(msgCopied, 'success');
    } catch {
      showToast(msgCopyFailed, 'error');
    }
  };

  // 收集文章中所有圖片作為 lightbox slides，並標記元素。
  let articleSlides: { src: string; alt?: string }[] = [];

  const buildArticleSlides = () => {
    const postBody = document.getElementById('post-body');
    if (!postBody) return;

    const allEls = Array.from(postBody.querySelectorAll<HTMLElement>('[data-lightbox-slides]'));

    const seen = new Set<string>();
    articleSlides = [];
    const elToGlobalIndex = new Map<HTMLElement, number>();

    for (const el of allEls) {
      const localSlides: { src: string; alt?: string }[] = JSON.parse(
        el.dataset.lightboxSlides ?? '[]'
      );
      const localIndex = Number(el.dataset.lightboxIndex ?? 0);
      const slide = localSlides[localIndex];
      if (!slide) continue;
      if (!seen.has(slide.src)) {
        seen.add(slide.src);
        articleSlides.push(slide);
      }
      elToGlobalIndex.set(
        el,
        articleSlides.findIndex((s) => s.src === slide.src)
      );
    }

    // 將 index 寫回元素，方便點擊時觸發正確的圖片。
    for (const [el, idx] of elToGlobalIndex) {
      el.dataset.lightboxGlobalIndex = String(idx);
    }
  };

  buildArticleSlides();

  // 點擊圖片時觸發 lightbox
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest('[data-lightbox-slides]') as HTMLElement | null;
    if (!el) return;
    const index = Number(el.dataset.lightboxGlobalIndex ?? 0);
    window.dispatchEvent(
      new CustomEvent(LIGHTBOX_EVENT, { detail: { slides: articleSlides, index } })
    );
  });

  // 每次頁面載入時執行
  document.addEventListener('astro:page-load', () => {
    if (onVisibilityChange) {
      document.removeEventListener('visibilitychange', onVisibilityChange);
      onVisibilityChange = null;
    }

    // 使用者切換分頁時暫停/播放影片
    const autoPlayVideos = document.querySelectorAll<HTMLVideoElement>(
      'video[data-auto-play="true"]'
    );
    if (autoPlayVideos.length) {
      onVisibilityChange = () => {
        autoPlayVideos.forEach((v) => (document.hidden ? v.pause() : v.play().catch(() => {})));
      };
      document.addEventListener('visibilitychange', onVisibilityChange);
    }

    // 分享、複製按鈕
    document.querySelectorAll<HTMLButtonElement>('[data-share-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.dataset.shareAction;
        const url = window.location.href;
        const container = btn.closest<HTMLElement>('[data-msg-copied]');
        const msgCopied = container?.dataset.msgCopied ?? '';
        const msgCopyFailed = container?.dataset.msgCopyFailed ?? '';

        if (action === 'copy') {
          await copyToClipboard(url, msgCopied, msgCopyFailed);
        } else if (action === 'native') {
          // 系統不支援分享時改用複製
          if (navigator.share) {
            try {
              await navigator.share({ url });
            } catch {}
          } else await copyToClipboard(url, msgCopied, msgCopyFailed);
        }
      });
    });
  });
</script>
