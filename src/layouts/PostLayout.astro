---
import { Image as AstroImage } from 'astro:assets';
import { createElement } from 'react';
import type { MDXContent as MDXContentType } from 'astro';

import type { Language, PostMeta } from '@/types';
import { Share2 } from '@lucide/astro';

import PostComments from '@/components/features/post/PostComments';
import PostLangMenu from '@/components/features/post/PostLangMenu.astro';
import TripMap from '@/components/features/post/TripMap';
import PostMetaInfo from '@/components/features/post/PostMetaInfo.astro';
import PostPasswordGate from '@/components/features/post/PostPasswordGate';
import RelatedPosts from '@/components/features/post/RelatedPosts.astro';
import Toc from '@/components/features/post/Toc';
import {
  Accordion,
  Alert,
  Badge,
  Card,
  Correction,
  FigureShell,
  H1,
  H2,
  H3,
  H4,
  H5,
  H6,
  Highlight,
  Image,
  Images,
  GalleryItem,
  Kbd,
  Link,
  MDXContent,
  Rating,
  SmallText,
  Spoiler,
  Table,
  Video,
} from '@/components/mdx';
import Lightbox from '@/components/mdx/Lightbox';
import CategoryBadge from '@/components/ui/CategoryBadge.astro';
import KofiBtn from '@/components/ui/KofiBtn.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createTranslator } from '@/lib/i18n';
import { withLocalePrefix } from '@/lib/paths';
import { normalizeTag } from '@/lib/tags';
import { createDateFormatter, parseToISODate } from '@/utils/date';

interface Props {
  lang: Language;
  post: PostMeta;
  otherLangs?: Language[];
  isProtected?: boolean;
  content?: MDXContentType;
  headings?: { depth: number; slug: string; text: string }[];
}

const props = Astro.props;

if (!props.post || !props.lang) throw new Error('PostLayout 至少需要提供 "post" 與 "lang" props。');

const { lang, post, otherLangs = [], isProtected = false, content, headings = [] } = props as Props;

const MDX_COMPONENTS = {
  Accordion,
  Alert,
  Badge,
  Card,
  Correction,
  FigureShell,
  h1: H1,
  h2: H2,
  h3: H3,
  h4: H4,
  h5: H5,
  h6: H6,
  Highlight,
  Image,
  Images,
  GalleryItem,
  Kbd,
  Link,
  Rating,
  SmallText,
  Spoiler,
  Table,
  Video,
  Iframe: (props: any) =>
    createElement('iframe', {
      src: props.src,
      height: props.height || 400,
      title: props.title || 'Iframe Embed',
      style: { width: '100%', border: '0' },
      scrolling: 'no',
      loading: 'lazy',
      allowFullScreen: true,
    }),
};

const tSettings = createTranslator(lang, 'settings');
const tCommon = createTranslator(lang, 'common');
const tPost = createTranslator(lang, 'PostPage');

const publishedDate = post.date ? parseToISODate(post.date) : null;
const dateFormatter = createDateFormatter(lang);
const updatedAt = post.updatedAt ? dateFormatter(post.updatedAt) : null;
const hasPlaces = (post.places ?? []).length > 0;

const tocHeadings = headings.map((h) => ({
  id: h.slug,
  text: h.text,
  level: h.depth,
}));

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(withLocalePrefix(`/posts/${post.slug}`, lang), siteUrl).href;
// 每篇文章的 schema.org Article 結構化資料
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  ...(post.description ? { description: post.description } : {}),
  ...(post.coverImage
    ? {
        image: new URL(post.coverImage, siteUrl).href,
      }
    : {}),
  datePublished: new Date(post.date).toISOString(),
  ...(post.updatedAt
    ? {
        dateModified: (post.updatedAt instanceof Date
          ? post.updatedAt
          : new Date(post.updatedAt)
        ).toISOString(),
      }
    : {}),
  author: {
    '@type': 'Person',
    name: 'kir4che',
    url: 'https://kir4che.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'kir4che',
    logo: {
      '@type': 'ImageObject',
      url: new URL('images/avatar.webp', siteUrl).href,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};
---

<SiteLayout
  title={isProtected ? tPost('passwordGate.title') : post.title}
  description={isProtected ? tPost('passwordGate.description') : post.description}
  image={!isProtected
    ? {
        url: `/og/${lang}/${post.slug}.png`,
        width: 1200,
        height: 630,
        type: 'image/png',
      }
    : undefined}
  pageTitle={!isProtected ? post.title : undefined}
>
  {
    !isProtected && (
      <fragment slot="head">
        <meta property="article:published_time" content={new Date(post.date).toISOString()} />
        {post.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </fragment>
    )
  }
  {
    isProtected && (
      <PostPasswordGate
        client:load
        slug={post.slug}
        lang={lang}
        backHref={withLocalePrefix('/archives', lang)}
      />
    )
  }
  <div data-protected-content class:list={[{ hidden: isProtected }]}>
    <>
      <article class="bg-surface-secondary/80 rounded p-4 transition-all duration-300 md:p-6">
        {
          post.coverImage && (
            <AstroImage
              src={post.coverImage}
              alt={`Cover image for ${post.title}`}
              width={1200}
              height={630}
              widths={[340, 680, 896, 1200]}
              sizes="(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1279px) calc(100vw - 3rem), 896px"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              draggable={false}
              class="mb-4 h-45 w-full rounded object-cover object-[center_70%] select-none sm:h-56 xl:h-68"
              transition:name={`post-cover-${post.slug}`}
            />
          )
        }
        <header class="mb-4">
          <h1 class="mb-4" transition:name={`post-title-${post.slug}`}>{post.title}</h1>
          <div class="flex-between flex-wrap gap-x-4 gap-y-1 select-none">
            <CategoryBadge lang={lang} categories={post.categories ?? []} />
            <div class="flex items-center gap-2">
              <PostMetaInfo lang={lang} date={post.date} wordCount={post.wordCount} />
              <span class="h-4 w-px bg-gray-200 transition-colors select-none dark:bg-gray-600/80"
              ></span>
              <div class="flex items-center gap-2">
                {
                  otherLangs.length > 0 && publishedDate && (
                    <PostLangMenu
                      curLang={lang}
                      currSlug={post.slug}
                      langs={otherLangs}
                      t={tSettings}
                    />
                  )
                }
                <button
                  type="button"
                  data-share-action="native"
                  data-msg-copied={tPost('share.copied')}
                  data-msg-copy-failed={tPost('share.copyFailed')}
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-pink-700 dark:text-pink-300"
                  aria-label={tPost('share.native')}
                >
                  <Share2 size={13} aria-hidden="true" />
                  <span>{tPost('share.label')}</span>
                </button>
              </div>
            </div>
          </div>
          {
            post.showUpdatedAt && updatedAt?.datetime && (
              <div class="dark:text-foreground-primary/70 flex justify-end text-xs text-gray-600">
                <time datetime={updatedAt.datetime}>
                  {tCommon('unit.updatedAt')} {updatedAt.display}
                </time>
              </div>
            )
          }
        </header>
        {hasPlaces && <TripMap client:visible places={post.places ?? []} />}
        {
          content ? (
            <MDXContent id="post-body" Content={content} extraComponents={MDX_COMPONENTS} />
          ) : null
        }
        <div class="pt-8">
          <PostComments client:visible slug={post.slug} hasPassword={isProtected} />
          <footer>
            <div class="rounded-xl bg-pink-50 p-5 text-center dark:bg-pink-900/10">
              <p class="mb-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {tPost('thanks')}
              </p>
              <KofiBtn label={tCommon('kofiButton')} />
            </div>
            {
              post.tags?.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-4 pb-2">
                  {post.tags.map((tag) => {
                    const normalizedTag = normalizeTag(tag, lang);
                    if (!normalizedTag) return null;

                    return (
                      <a
                        href={withLocalePrefix(`/tags/${normalizedTag.slug}`, lang)}
                        class="inline-flex items-center rounded-full bg-pink-100/60 px-3 py-1 text-sm text-pink-700 transition-colors hover:bg-pink-200/70 dark:bg-pink-900/20 dark:text-pink-300 dark:hover:bg-pink-800/30"
                        aria-label={`#${normalizedTag.name}`}
                      >
                        #{normalizedTag.name}
                      </a>
                    );
                  })}
                </div>
              )
            }
          </footer>
        </div>
      </article>
      <RelatedPosts lang={lang} currSlug={post.slug} categories={post.categories ?? []} />
      <Toc
        client:load
        headings={tocHeadings}
        title={tPost('toc.title')}
        expandLabel={tPost('toc.expand')}
        collapseLabel={tPost('toc.collapse')}
      />
    </>
  </div>
  <Lightbox client:idle />
</SiteLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
<script>
  import { LIGHTBOX_EVENT } from '@/components/mdx/LightboxEvents';
  let lightboxSlides: { src: string; alt?: string }[] = [];

  const rebuildLightboxSlides = () => {
    const postBody = document.getElementById('post-body');
    if (!postBody) return;

    const allEls = Array.from(postBody.querySelectorAll<HTMLElement>('[data-lightbox-src]'));
    if (allEls.length === 0) return;

    lightboxSlides = [];
    allEls.forEach((el) => {
      const src = el.dataset.lightboxSrc!;
      const alt = el.dataset.lightboxAlt;
      // 依序將 lightbox 圖片加入 lightboxSlides 陣列，並在元素上標記索引。
      el.dataset.lightboxGlobalIndex = String(lightboxSlides.push({ src, alt }) - 1);
    });
  };

  const handleLightboxClick = (e: MouseEvent) => {
    const lbEl = (e.target as Element).closest('[data-lightbox-src]') as HTMLElement | null;
    if (!lbEl) return;

    const index = Number(lbEl.dataset.lightboxGlobalIndex ?? 0);
    // 傳入 lightboxSlides 與 index 並觸發 lightbox 事件
    window.dispatchEvent(
      new CustomEvent(LIGHTBOX_EVENT, { detail: { slides: lightboxSlides, index } })
    );
  };

  document.addEventListener('click', handleLightboxClick);

  // 分享按鈕：Web Share API（行動裝置優先）→ 降級為複製連結 + 按鈕文字回饋
  const handleShareClick = async (e: MouseEvent) => {
    const shareBtn = (e.target as Element).closest<HTMLButtonElement>('[data-share-action]');
    if (!shareBtn) return;

    const url = window.location.href;
    const labelSpan = shareBtn.querySelector<HTMLSpanElement>('span');
    const originalText = labelSpan?.textContent ?? '';
    const msgCopied = shareBtn.dataset.msgCopied ?? '';
    const msgCopyFailed = shareBtn.dataset.msgCopyFailed ?? '';

    if (navigator.share) {
      await navigator.share({ url }).catch(() => {});
      return;
    }

    try {
      await navigator.clipboard.writeText(url);
      if (labelSpan && msgCopied) labelSpan.textContent = msgCopied;
    } catch {
      if (labelSpan && msgCopyFailed) labelSpan.textContent = msgCopyFailed;
    }

    if (labelSpan)
      setTimeout(() => {
        labelSpan.textContent = originalText;
      }, 2000);
  };

  document.addEventListener('click', handleShareClick);

  const init = () => {
    rebuildLightboxSlides();
  };

  init();

  document.addEventListener('astro:page-load', init);

  // 監聽文章解鎖事件（PostPasswordGate），移除受保護內容的 hidden class。
  if (!document.body.dataset.postUnlockInit) {
    document.body.dataset.postUnlockInit = 'true';
    window.addEventListener('post:unlocked', () => {
      document.querySelector<HTMLElement>('[data-protected-content]')?.classList.remove('hidden');
    });
  }
</script>
