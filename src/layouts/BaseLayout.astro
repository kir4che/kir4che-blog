---
import type { Language } from '@/types';
import { LANGUAGE_TO_LOCALE_MAP } from '@/config';
import { getSeoConfig } from '@/lib/seo';
import { getLocaleFromUrl } from '@/lib/i18n';
import Toast from '@/components/ui/Toast.astro';
import ThemeScript from '@/components/layouts/ThemeScript.astro';

import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: {
    url: string;
    alt?: string;
    width?: number;
    height?: number;
    type?: string;
  };
  noindex?: boolean;
}

const { title, description, canonical, image, noindex } = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const currUrl = Astro.url;
const currLang: Language = getLocaleFromUrl(currUrl);
const seoConfig = getSeoConfig(siteOrigin, currLang, currUrl);

const keywords = seoConfig.keywords.length > 0 ? seoConfig.keywords.join(', ') : null;
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${siteOrigin}${canonical}`
  : seoConfig.canonical;
const resolvedImage = image ?? seoConfig.openGraph.images[0] ?? null;
const shouldIndex = noindex ? 'noindex,nofollow' : seoConfig.robots;
const locale = LANGUAGE_TO_LOCALE_MAP[currLang] || currLang;
---

<!doctype html>
<html lang={locale}>
  <head>
    <ThemeScript />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://cdn.kir4che.com" crossorigin />
    <title>
      {title ? seoConfig.title.template.replace('%s', title) : seoConfig.title.default}
    </title>
    <meta name="description" content={description ?? seoConfig.description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={shouldIndex} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:title" content={title ?? seoConfig.openGraph.title} />
    <meta property="og:description" content={description ?? seoConfig.openGraph.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={seoConfig.openGraph.type} />
    <meta property="og:site_name" content={seoConfig.openGraph.siteName} />
    <meta property="og:locale" content={seoConfig.openGraph.locale} />
    {
      seoConfig.openGraph.localeAlternates?.map((alt) => (
        <meta property="og:locale:alternate" content={alt} />
      ))
    }
    <!-- Twitter Card -->
    <meta name="twitter:card" content={seoConfig.twitter.card} />
    <meta name="twitter:title" content={title ?? seoConfig.twitter.title} />
    <meta name="twitter:description" content={description ?? seoConfig.twitter.description} />
    <!-- Hreflang -->
    {
      Object.entries(seoConfig.alternates).map(([locale, url]) => (
        <link rel="alternate" hreflang={locale} href={url} />
      ))
    }
    {
      resolvedImage && (
        <>
          <meta
            property="og:image"
            content={
              resolvedImage.url.startsWith('http')
                ? resolvedImage.url
                : new URL(resolvedImage.url, siteOrigin).href
            }
          />
          {resolvedImage.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}
          {resolvedImage.width && (
            <meta property="og:image:width" content={String(resolvedImage.width)} />
          )}
          {resolvedImage.height && (
            <meta property="og:image:height" content={String(resolvedImage.height)} />
          )}
          {resolvedImage.type && <meta property="og:image:type" content={resolvedImage.type} />}
          <meta
            name="twitter:image"
            content={
              resolvedImage.url.startsWith('http')
                ? resolvedImage.url
                : new URL(resolvedImage.url, siteOrigin).href
            }
          />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="preload">
    <Toast />
    <slot />
    <script>
      // 移除 preload class 以啟用 CSS transition，避免首次渲染閃爍。
      const clearPreload = () => document.body.classList.remove('preload');
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', clearPreload, { once: true });
      else clearPreload();
      document.addEventListener('astro:page-load', clearPreload);
    </script>
    <script>
      const root = '[data-lang-menu]';
      const toggle = '[data-lang-menu-toggle]';
      const list = '[data-lang-menu-list]';
      const item = '[data-lang-menu-item]';
      const hoverAttr = 'data-lang-menu-hover';

      // 以 dataset 標記避免 astro:page-load 重複綁定事件到同一個 menu 元素
      const initMenu = (menu: HTMLElement) => {
        if (menu.dataset.langMenuBound === 'true') return;
        menu.dataset.langMenuBound = 'true';

        const btn = menu.querySelector<HTMLElement>(toggle);
        const panel = menu.querySelector<HTMLElement>(list);
        if (!btn || !panel) return;

        let isOpen = false;

        const open = () => {
          isOpen = true;
          panel.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        };

        const close = () => {
          isOpen = false;
          panel.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        };

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          isOpen ? close() : open();
        });

        if (menu.hasAttribute(hoverAttr)) {
          let timer: number | undefined;
          const scheduleClose = () => {
            if (timer) window.clearTimeout(timer);
            timer = window.setTimeout(close, 120);
          };
          const cancelClose = () => {
            if (timer) window.clearTimeout(timer);
          };

          btn.addEventListener('mouseenter', open);
          btn.addEventListener('mouseleave', scheduleClose);
          panel.addEventListener('mouseenter', cancelClose);
          panel.addEventListener('mouseleave', scheduleClose);
        }

        menu
          .querySelectorAll<HTMLElement>(item)
          .forEach((el) => el.addEventListener('click', close));
      };

      const closeAll = () => {
        document.querySelectorAll<HTMLElement>(list).forEach((el) => el.classList.add('hidden'));
        document
          .querySelectorAll<HTMLElement>(toggle)
          .forEach((el) => el.setAttribute('aria-expanded', 'false'));
      };

      const initMenus = () => {
        document.querySelectorAll<HTMLElement>(root).forEach(initMenu);
      };

      // window 單例：全域 click/Escape 監聽器只註冊一次，跨 Astro SPA 頁面共用。
      const win = window as Window & { __langMenuInit?: boolean };
      if (!win.__langMenuInit) {
        win.__langMenuInit = true;

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          if (!target.closest(root)) closeAll();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeAll();
        });

        if (document.readyState !== 'loading') initMenus();
        else document.addEventListener('DOMContentLoaded', initMenus, { once: true });

        document.addEventListener('astro:page-load', initMenus);
      } else initMenus();
    </script>
  </body>
</html>
