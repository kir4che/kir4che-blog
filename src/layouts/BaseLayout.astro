---
import type { Language } from '@/types';
import { getSeoConfig } from '@/lib/seo';
import { getLocaleFromUrl } from '@/lib/i18n';
import Toast from '@/components/ui/Toast.astro';
import langMenu from '@/scripts/langMenu.ts?url';

import '@/styles/globals.css';

const { title, description, canonical, image, noindex } = Astro.props as {
  title?: string;
  description?: string;
  canonical?: string;
  image?: {
    url: string;
    alt?: string;
    width?: number;
    height?: number;
    type?: string;
  };
  noindex?: boolean;
};

const lang: Language = getLocaleFromUrl(Astro.url);
const seo = getSeoConfig(lang, Astro.url);

const slugParam = Astro.params?.slug;
const slugSegments = Array.isArray(slugParam)
  ? slugParam
  : typeof slugParam === 'string'
    ? [slugParam]
    : null;
const langParam = typeof Astro.params?.lang === 'string' ? Astro.params.lang : null;
const isArticlePage = Boolean(slugSegments && langParam);
const rawSiteUrl = import.meta.env.PUBLIC_SITE_URL || process.env.SITE_URL || Astro.url.origin;
const siteUrl = rawSiteUrl.replace(/\/+$/, '');
const lazyOgImageUrl = isArticlePage
  ? `${siteUrl}/og/${langParam}/${(slugSegments ?? []).join('/')}.png`
  : null;

const keywords = seo.keywords.length > 0 ? seo.keywords.join(', ') : null;
const googleAnalyticsId = import.meta.env.GOOGLE_ANALYTICS_ID;
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${siteUrl}${canonical}`
  : seo.canonical;
const shouldIndex = noindex ? 'noindex,nofollow' : seo.robots;

const resolvedImageUrl = image?.url
  ? image.url.startsWith('http')
    ? image.url
    : `${siteUrl}${image.url.startsWith('/') ? image.url : `/${image.url}`}`
  : null;

const imageOverride = resolvedImageUrl
  ? [
      { name: 'og:image', content: resolvedImageUrl },
      ...(image?.alt ? [{ name: 'og:image:alt', content: image.alt }] : []),
      ...(image?.width ? [{ name: 'og:image:width', content: String(image.width) }] : []),
      ...(image?.height ? [{ name: 'og:image:height', content: String(image.height) }] : []),
      ...(image?.type ? [{ name: 'og:image:type', content: image.type }] : []),
      { name: 'twitter:image', content: resolvedImageUrl },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {title ? seo.title.template.replace('%s', title) : seo.title.default}
    </title>
    <meta name="description" content={description ?? seo.description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={shouldIndex} />
    <link rel="canonical" href={canonicalUrl} />
    {
      Object.entries(seo.alternates).map(([locale, href]) => (
        <link rel="alternate" hreflang={locale} href={href} />
      ))
    }
    <link rel="icon" href={seo.icons.icon} />
    <link rel="apple-touch-icon" href={seo.icons.apple} />
    <meta property="og:type" content={isArticlePage ? 'article' : seo.openGraph.type} />
    <meta property="og:title" content={seo.openGraph.title} />
    <meta property="og:description" content={seo.openGraph.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={seo.openGraph.siteName} />
    <meta property="og:locale" content={seo.openGraph.locale} />
    {
      seo.openGraph.localeAlternates?.map((locale) => (
        <meta property="og:locale:alternate" content={locale} />
      ))
    }
    {
      imageOverride.length > 0 ? (
        imageOverride.map(({ name, content }) =>
          name.startsWith('og:') ? (
            <meta property={name} content={content} />
          ) : (
            <meta name={name} content={content} />
          )
        )
      ) : lazyOgImageUrl ? (
        <>
          <meta property="og:image" content={lazyOgImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={lazyOgImageUrl} />
        </>
      ) : (
        seo.openGraph.images.map((ogImage) => (
          <>
            <meta property="og:image" content={ogImage.url} />
            <meta property="og:image:alt" content={ogImage.alt} />
            <meta property="og:image:width" content={String(ogImage.width)} />
            <meta property="og:image:height" content={String(ogImage.height)} />
            {ogImage.type && <meta property="og:image:type" content={ogImage.type} />}
          </>
        ))
      )
    }
    <meta name="twitter:card" content={seo.twitter.card} />
    <meta name="twitter:title" content={seo.twitter.title} />
    <meta name="twitter:description" content={seo.twitter.description} />
    {
      imageOverride.length === 0 &&
        seo.twitter.images.map((imageUrl) => <meta name="twitter:image" content={imageUrl} />)
    }
    {
      seo.verification?.google && (
        <meta name="google-site-verification" content={seo.verification.google} />
      )
    }
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      googleAnalyticsId && (
        <script
          async
          is:inline
          src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
        />
      )
    }
    {
      googleAnalyticsId && (
        <script is:inline>
          {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${googleAnalyticsId}');`}
        </script>
      )
    }
  </head>
  <body>
    <slot />
    <Toast />
    <script type="module" src={langMenu}></script>
  </body>
</html>
